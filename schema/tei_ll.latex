\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}{name}="{spouse}"\hspace*{6pt}{type}="{personal}"/>}\mbox{}\newline 
\hspace*{6pt}{</\textbf{listRelation}>}\mbox{}\newline 
{</\textbf{listPerson}>}\end{shaded}\egroup 


