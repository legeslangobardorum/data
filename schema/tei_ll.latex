    \item[{Example}]
  Here is an example of a \hyperref[TEI.unit]{<unit>} element holding a {\itshape unitRef} attribute that points to a definition of the unit in the TEI header.\leavevmode\bgroup\exampleFont \begin{shaded}\noindent\mbox{}{<\textbf{measure}>}\mbox{}\newline 
\hspace*{6pt}{<\textbf{num}>}3{</\textbf{num}>}\mbox{}\newline 
\hspace*{6pt}{<\textbf{unit}\hspace*{6pt}{unitRef}="{\#ell}">}ells{</\textbf{unit}>}\mbox{}\newline 
{</\textbf{measure}>}\mbox{}\newline 
\textit{<!-- In the TEI Header: -->}\mbox{}\newline 
{<\textbf{encodingDesc}>}\mbox{}\newline 
\hspace*{6pt}{<\textbf{unitDecl}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{<\textbf{unitDef}\hspace*{6pt}{xml:id}="{ell}">}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}{<\textbf{label}>}ell{</\textbf{label}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}{<\textbf{placeName}\hspace*{6pt}{ref}="{\#iceland}"/>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}{<\textbf{desc}>}A unit of measure for cloth, roughly equivalent to 18 inches, or from an adult male’s elbow to the tip of the middle finger.{</\textbf{desc}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{</\textbf{unitDef}>}\mbox{}\newline 
\hspace*{6pt}{</\textbf{unitDecl}>}\mbox{}\newline 
{</\textbf{encodingDesc}>}\end{shaded}\egroup 


    \item[{Example}]
  \leavevmode\bgroup\exampleFont \begin{shaded}\noindent\mbox{}{<\textbf{measure}>}\mbox{}\newline 
\hspace*{6pt}{<\textbf{num}>}2{</\textbf{num}>}\mbox{}\newline 
\hspace*{6pt}{<\textbf{unit}>}kg{</\textbf{unit}>}\mbox{}\newline 
{</\textbf{measure}>}\end{shaded}\egroup 


    \item[{Example}]
  \leavevmode\bgroup\exampleFont \begin{shaded}\noindent\mbox{}{<\textbf{measure}\hspace*{6pt}{type}="{value}">}\mbox{}\newline 
\hspace*{6pt}{<\textbf{num}>}3{</\textbf{num}>}\mbox{}\newline 
\hspace*{6pt}{<\textbf{unit}\hspace*{6pt}{type}="{time}"\hspace*{6pt}{unit}="{min}">}minute{</\textbf{unit}>}\mbox{}\newline 
{</\textbf{measure}>}\end{shaded}\egroup 


    \item[{Example}]
  \leavevmode\bgroup\exampleFont \begin{shaded}\noindent\mbox{}{<\textbf{measure}\hspace*{6pt}{type}="{interval}">}\mbox{}\newline 
\hspace*{6pt}{<\textbf{num}\hspace*{6pt}{atLeast}="{1.2}">}1.2{</\textbf{num}>} to {<\textbf{num}\hspace*{6pt}{atMost}="{5.6}">}5.6{</\textbf{num}>}\mbox{}\newline 
\hspace*{6pt}{<\textbf{unit}\hspace*{6pt}{type}="{velocity}"\hspace*{6pt}{unit}="{km/h}">}km/h{</\textbf{unit}>}\mbox{}\newline 
{</\textbf{measure}>}\end{shaded}\egroup 


    \item[{Example}]
  \leavevmode\bgroup\exampleFont \begin{shaded}\noindent\mbox{}{<\textbf{p}>}Light travels at {<\textbf{num}\hspace*{6pt}{value}="{3E10}">}3×10\textasciicircum 10{</\textbf{num}>}\mbox{}\newline 
\hspace*{6pt}{<\textbf{unit}\hspace*{6pt}{type}="{rate}"\hspace*{6pt}{unit}="{cm/s}">}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{<\textbf{unit}\hspace*{6pt}{type}="{space}">}cm{</\textbf{unit}>} per {<\textbf{unit}\hspace*{6pt}{type}="{time}">}second{</\textbf{unit}>}\mbox{}\newline 
\hspace*{6pt}{</\textbf{unit}>}.{</\textbf{p}>}\end{shaded}\egroup 


