\hspace*{6pt}\hspace*{6pt}{<\textbf{line}>}Mama{</\textbf{line}>}\mbox{}\newline 
\hspace*{6pt}{</\textbf{zone}>}\mbox{}\newline 
\hspace*{6pt}{<\textbf{zone}>}\mbox{}\newline 
