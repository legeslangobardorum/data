    \item[{Example}]
  \leavevmode\bgroup\exampleFont \begin{shaded}\noindent\mbox{}{<\textbf{object}\hspace*{6pt}{xml:id}="{Excalibur-MultipleNames}">}\mbox{}\newline 
\hspace*{6pt}{<\textbf{objectIdentifier}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{<\textbf{objectName}\hspace*{6pt}{type}="{main}">}Excalibur{</\textbf{objectName}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{<\textbf{objectName}\hspace*{6pt}{type}="{alt}">}Caliburn{</\textbf{objectName}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{<\textbf{objectName}\hspace*{6pt}{xml:lang}="{cy}">}Caledfwlch{</\textbf{objectName}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{<\textbf{objectName}\hspace*{6pt}{xml:lang}="{cnx}">}Calesvol{</\textbf{objectName}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{<\textbf{objectName}\hspace*{6pt}{xml:lang}="{br}">}Kaledvoulc'h{</\textbf{objectName}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{<\textbf{objectName}\hspace*{6pt}{xml:lang}="{la}">}Caliburnus{</\textbf{objectName}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{<\textbf{country}>}Wales{</\textbf{country}>}\mbox{}\newline 
\hspace*{6pt}{</\textbf{objectIdentifier}>}\mbox{}\newline 
\hspace*{6pt}{<\textbf{p}>}Excalibur is the name for the legendary sword of King Arthur, in Welsh it is called Caledfwlch,\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt} in Cornish it is called Calesvol, in Breton it is called Kaledvoulc'h, and in Latin it is called Caliburnus.\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt} In some versions Excalibur's blade was engraved with phrases on opposite sides which in translation read:\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt} "Take me up" and "Cast me away" (or similar).{</\textbf{p}>}\mbox{}\newline 
{</\textbf{object}>}\end{shaded}\egroup 


