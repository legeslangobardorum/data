element sp
{
   tei_att.global.attributes,
   tei_att.ascribed.directed.attributes,
   (
      tei_model.global*,
      ( ( tei_speaker, tei_model.global* )? ),
      (
         (
            (
               tei_lg             | tei_model.lLike             | tei_model.pLike             | tei_model.listLike             | tei_model.stageLike             | tei_model.attributable            ),
            ( tei_model.global* | tei_q )
         )+
      )
   )
}
\end{Verbatim}

