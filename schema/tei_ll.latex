    \item[{Note}]
  \par
The {\itshape type} attribute may be used to indicate the type of clause, taking values such as finite, nonfinite, declarative, interrogative, relative etc. as appropriate.
    \item[{Example}]
  \leavevmode\bgroup\exampleFont \begin{shaded}\noindent\mbox{}{<\textbf{l}>}\mbox{}\newline 
\hspace*{6pt}{<\textbf{cl}\hspace*{6pt}{function}="{clause\textunderscore modifier}"\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{type}="{relative}">}Which frightened\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt} both the heroes so,{</\textbf{cl}>}\mbox{}\newline 
{</\textbf{l}>}\mbox{}\newline 
{<\textbf{l}>}\mbox{}\newline 
\hspace*{6pt}{<\textbf{cl}>}They quite forgot their quarrel.{</\textbf{cl}>}\mbox{}\newline 
{</\textbf{l}>}\end{shaded}\egroup 


