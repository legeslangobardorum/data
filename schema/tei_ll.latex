element supportDesc
{
   tei_att.global.attributes,
   attribute material { "paper" | "parch" | "mixed" }?,
   (
      tei_model.pLike+
    | (
         tei_support?,
         tei_extent?,
         tei_foliation*,
         tei_collation?,
         tei_condition?
      )
   )
}
\end{Verbatim}

