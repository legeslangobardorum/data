element facsimile
{
   tei_att.global.attributes,
   tei_att.declaring.attributes,
   (
      tei_front?,
      ( tei_model.graphicLike | tei_surface | tei_surfaceGrp )+,
      tei_back?
   )
}
\end{Verbatim}

