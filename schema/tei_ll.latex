element joinGrp
{
   tei_att.global.attributes,
   tei_att.pointing.group.attributes,
   tei_att.cmc.attributes,
   attribute result { text }?,
   ( ( equiv | tei_gloss | tei_model.descLike )*, ( tei_join | tei_ptr )+ )
}
\end{Verbatim}

\end{reflist}  \index{keywords=<keywords>|oddindex}\index{scheme=@scheme!<keywords>|oddindex}
\begin{reflist}
\item[]\begin{specHead}{TEI.keywords}{<keywords> }(keywords) contains a list of keywords or phrases identifying the topic or nature of a text. [\xref{https://www.tei-c.org/release/doc/tei-p5-doc/en/html/HD.html\#HD43}{2.4.3. The Text Classification}]\end{specHead} 
    \item[{Module}]
