  \leavevmode\bgroup\exampleFont \begin{shaded}\noindent\mbox{}{<\textbf{refState}\hspace*{6pt}{delim}="{:}"\hspace*{6pt}{unit}="{book}"/>}\mbox{}\newline 
{<\textbf{refState}\hspace*{6pt}{length}="{4}"\hspace*{6pt}{unit}="{line}"/>}\end{shaded}\egroup 


