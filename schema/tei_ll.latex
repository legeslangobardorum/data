\end{reflist}  \index{variantEncoding=<variantEncoding>|oddindex}\index{method=@method!<variantEncoding>|oddindex}\index{location=@location!<variantEncoding>|oddindex}
\begin{reflist}
\item[]\begin{specHead}{TEI.variantEncoding}{<variantEncoding> }(variant encoding) declares the method used to encode text-critical variants. [\xref{https://www.tei-c.org/release/doc/tei-p5-doc/en/html/TC.html\#TCAPEN}{13.1.1. The Apparatus Entry}]\end{specHead} 
    \item[{Module}]
  textcrit
    \item[{Attributes}]
  \begin{itemize}
\item \hyperref[TEI.att.global]{att.global}\begin{itemize}
\item \textit{@xml:id}
\item \textit{@n}
\item \textit{@xml:lang}
\item \textit{@xml:base}
\item \textit{@xml:space}
\end{itemize} \begin{itemize}
\item \hyperref[TEI.att.global.rendition]{att.global.rendition}\begin{itemize}
\item \textit{@rend}
\item \textit{@style}
\item \textit{@rendition}
\end{itemize} 
\item \hyperref[TEI.att.global.linking]{att.global.linking}\begin{itemize}
\item \textit{@corresp}
\item \textit{@synch}
\item \textit{@sameAs}
\item \textit{@copyOf}
\item \textit{@next}
\item \textit{@prev}
\item \textit{@exclude}
\item \textit{@select}
\end{itemize} 
\item \hyperref[TEI.att.global.analytic]{att.global.analytic}\begin{itemize}
\item \textit{@ana}
\end{itemize} 
\item \hyperref[TEI.att.global.facs]{att.global.facs}\begin{itemize}
\item \textit{@facs}
\end{itemize} 
\item \hyperref[TEI.att.global.change]{att.global.change}\begin{itemize}
\item \textit{@change}
\end{itemize} 
\item \hyperref[TEI.att.global.responsibility]{att.global.responsibility}\begin{itemize}
\item \textit{@cert}
\item \textit{@resp}
\end{itemize} 
\item \hyperref[TEI.att.global.source]{att.global.source}\begin{itemize}
\item \textit{@source}
\end{itemize} 
\end{itemize} 
\end{itemize} \hfil\\[-10pt]\begin{sansreflist}
    \item[@method]
  indicates which method is used to encode the apparatus of variants.
\begin{reflist}
    \item[{Status}]
  Required
    \item[{Datatype}]
  \hyperref[TEI.teidata.enumerated]{teidata.enumerated}
    \item[{Legal values are:}]
  \begin{description}

\item[{location-referenced}]apparatus uses line numbers or other canonical reference scheme referenced in a base text.
\item[{double-end-point}]apparatus indicates the precise locations of the beginning and ending of each lemma relative to a base text.
\item[{parallel-segmentation}]alternate readings of a passage are given in parallel in the text; no notion of a base text is necessary.
\end{description} 
    \item[{Note}]
  \par
The value ‘parallel-segmentation’ requires in-line encoding of the apparatus.
\end{reflist}  
    \item[@location]
  indicates whether the apparatus appears within the running text or external to it.
\begin{reflist}
    \item[{Status}]
  Required
    \item[{Datatype}]
  \hyperref[TEI.teidata.enumerated]{teidata.enumerated}
    \item[{Schematron}]
   <sch:rule context="tei:variantEncoding"> <sch:report test="@location eq 'external' and @method eq 'parallel-segmentation'"> The @location value "external" is inconsistent with the  parallel-segmentation method of apparatus markup.</sch:report> </sch:rule>
    \item[{Legal values are:}]
  \begin{description}

\item[{internal}]apparatus appears within the running text.
\item[{external}]apparatus appears outside the base text.
\end{description} 
    \item[{Note}]
  \par
The value ‘external’ is inconsistent with the parallel-segmentation method of apparatus markup.
\end{reflist}  
\end{sansreflist}  
    \item[{Member of}]
  \hyperref[TEI.model.encodingDescPart]{model.encodingDescPart}
    \item[{Contained by}]
  
    \item[header: ]
   \hyperref[TEI.encodingDesc]{encodingDesc}
    \item[{May contain}]
  Empty element
    \item[{Example}]
  \leavevmode\bgroup\exampleFont \begin{shaded}\noindent\mbox{}{<\textbf{variantEncoding}\hspace*{6pt}{location}="{external}"\mbox{}\newline 
\hspace*{6pt}{method}="{location-referenced}"/>}\end{shaded}\egroup 


    \item[{Content model}]
  \fbox{\ttfamily <content>\newline
 <empty/>\newline
</content>\newline
    } 
    \item[{Schema Declaration}]
  \mbox{}\hfill\\[-10pt]\begin{Verbatim}[fontsize=\small]
element variantEncoding
{
   tei_att.global.attributes,
   attribute method
   {
      "location-referenced" | "double-end-point" | "parallel-segmentation"
   },
   attribute location { "internal" | "external" },
   empty
}
\end{Verbatim}

