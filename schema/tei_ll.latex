    \item[{Schema Declaration}]
  \mbox{}\hfill\\[-10pt]\begin{Verbatim}[fontsize=\small]
element num
{
   tei_att.global.attributes,
   tei_att.typed.attribute.subtype,
   tei_att.ranging.attributes,
   tei_att.cmc.attributes,
   attribute type { text }?,
   attribute value { text }?,
   tei_macro.phraseSeq}
\end{Verbatim}

\end{reflist}  \index{number=<number>|oddindex}
\begin{reflist}
