<content>
 <alternate>
  <classRef key="model.pLike"
   maxOccurs="unbounded" minOccurs="1"/>
  <elementRef key="citeStructure"
   maxOccurs="unbounded" minOccurs="1"/>
  <elementRef key="cRefPattern"
   maxOccurs="unbounded" minOccurs="1"/>
  <elementRef key="refState"
   maxOccurs="unbounded" minOccurs="1"/>
 </alternate>
</content>
    
\end{Verbatim}

