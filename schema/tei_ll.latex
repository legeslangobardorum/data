      text
    | tei_model.gLike    | tei_model.global    | tei_model.inter    | tei_model.phrase    | tei_def    | tei_etym    | tei_gramGrp    | tei_lbl    | tei_usg    | tei_xr   )*
}
\end{Verbatim}

