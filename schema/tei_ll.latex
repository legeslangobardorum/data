\end{reflist}  \index{analytic=<analytic>|oddindex}
\begin{reflist}
\item[]\begin{specHead}{TEI.analytic}{<analytic> }(analytic level) contains bibliographic elements describing an item (e.g. an article or poem) published within a monograph or journal and not as an independent publication. [\xref{https://www.tei-c.org/release/doc/tei-p5-doc/en/html/CO.html\#COBICOL}{3.12.2.1. Analytic, Monographic, and Series Levels}]\end{specHead} 
    \item[{Module}]
  core
    \item[{Attributes}]
  \begin{itemize}
\item \hyperref[TEI.att.global]{att.global}\begin{itemize}
\item \textit{@xml:id}
\item \textit{@n}
\item \textit{@xml:lang}
\item \textit{@xml:base}
\item \textit{@xml:space}
\end{itemize} \begin{itemize}
\item \hyperref[TEI.att.global.rendition]{att.global.rendition}\begin{itemize}
\item \textit{@rend}
\item \textit{@style}
\item \textit{@rendition}
\end{itemize} 
\item \hyperref[TEI.att.global.linking]{att.global.linking}\begin{itemize}
\item \textit{@corresp}
\item \textit{@synch}
\item \textit{@sameAs}
\item \textit{@copyOf}
\item \textit{@next}
\item \textit{@prev}
\item \textit{@exclude}
\item \textit{@select}
\end{itemize} 
\item \hyperref[TEI.att.global.analytic]{att.global.analytic}\begin{itemize}
\item \textit{@ana}
\end{itemize} 
\item \hyperref[TEI.att.global.facs]{att.global.facs}\begin{itemize}
\item \textit{@facs}
\end{itemize} 
\item \hyperref[TEI.att.global.change]{att.global.change}\begin{itemize}
\item \textit{@change}
\end{itemize} 
\item \hyperref[TEI.att.global.responsibility]{att.global.responsibility}\begin{itemize}
\item \textit{@cert}
\item \textit{@resp}
\end{itemize} 
\item \hyperref[TEI.att.global.source]{att.global.source}\begin{itemize}
\item \textit{@source}
\end{itemize} 
\end{itemize} 
\end{itemize} 
    \item[{Contained by}]
  
    \item[core: ]
   \hyperref[TEI.biblStruct]{biblStruct}
    \item[{May contain}]
  
    \item[core: ]
   \hyperref[TEI.author]{author} \hyperref[TEI.date]{date} \hyperref[TEI.editor]{editor} \hyperref[TEI.ptr]{ptr} \hyperref[TEI.ref]{ref} \hyperref[TEI.respStmt]{respStmt} \hyperref[TEI.textLang]{textLang} \hyperref[TEI.title]{title}\par 
    \item[header: ]
   \hyperref[TEI.availability]{availability} \hyperref[TEI.idno]{idno}
    \item[{Note}]
  \par
May contain titles and statements of responsibility (author, editor, or other), in any order.\par
The \hyperref[TEI.analytic]{<analytic>} element may only occur within a \hyperref[TEI.biblStruct]{<biblStruct>}, where its use is mandatory for the description of an analytic level bibliographic item.
    \item[{Example}]
  \leavevmode\bgroup\exampleFont \begin{shaded}\noindent\mbox{}{<\textbf{biblStruct}>}\mbox{}\newline 
\hspace*{6pt}{<\textbf{analytic}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{<\textbf{author}>}Chesnutt, David{</\textbf{author}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{<\textbf{title}>}Historical Editions in the States{</\textbf{title}>}\mbox{}\newline 
\hspace*{6pt}{</\textbf{analytic}>}\mbox{}\newline 
\hspace*{6pt}{<\textbf{monogr}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{<\textbf{title}\hspace*{6pt}{level}="{j}">}Computers and the Humanities{</\textbf{title}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{<\textbf{imprint}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}{<\textbf{date}\hspace*{6pt}{when}="{1991-12}">}(December, 1991):{</\textbf{date}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{</\textbf{imprint}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{<\textbf{biblScope}>}25.6{</\textbf{biblScope}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{<\textbf{biblScope}>}377–380{</\textbf{biblScope}>}\mbox{}\newline 
\hspace*{6pt}{</\textbf{monogr}>}\mbox{}\newline 
{</\textbf{biblStruct}>}\end{shaded}\egroup 


