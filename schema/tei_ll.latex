\hspace*{6pt}{</\textbf{form}>}\mbox{}\newline 
\hspace*{6pt}{<\textbf{etym}>}[Fr. < {<\textbf{mentioned}>}laver{</\textbf{mentioned}>}; L. {<\textbf{mentioned}>}lavare{</\textbf{mentioned}>}, to wash;\mbox{}\newline 
\hspace*{6pt}{<\textbf{xr}>}see {<\textbf{ref}>}lather{</\textbf{ref}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{</\textbf{xr}>}]. {</\textbf{etym}>}\mbox{}\newline 
{</\textbf{entry}>}\end{shaded}\egroup 


