   tei_macro.paraContent}
\end{Verbatim}

\end{reflist}  \index{hyphenation=<hyphenation>|oddindex}\index{eol=@eol!<hyphenation>|oddindex}
\begin{reflist}
\item[]\begin{specHead}{TEI.hyphenation}{<hyphenation> }(hyphenation) summarizes the way in which hyphenation in a source text has been treated in an encoded version of it. [\xref{https://www.tei-c.org/release/doc/tei-p5-doc/en/html/HD.html\#HD53}{2.3.3. The Editorial Practices Declaration} \xref{https://www.tei-c.org/release/doc/tei-p5-doc/en/html/CC.html\#CCAS2}{16.3.2. Declarable Elements}]\end{specHead} 
    \item[{Module}]
  header
    \item[{Attributes}]
  \begin{itemize}
\item \hyperref[TEI.att.global]{att.global}\begin{itemize}
\item \textit{@xml:id}
\item \textit{@n}
\item \textit{@xml:lang}
\item \textit{@xml:base}
\item \textit{@xml:space}
\end{itemize} \begin{itemize}
\item \hyperref[TEI.att.global.rendition]{att.global.rendition}\begin{itemize}
\item \textit{@rend}
\item \textit{@style}
\item \textit{@rendition}
\end{itemize} 
\item \hyperref[TEI.att.global.linking]{att.global.linking}\begin{itemize}
\item \textit{@corresp}
\item \textit{@synch}
\item \textit{@sameAs}
\item \textit{@copyOf}
\item \textit{@next}
\item \textit{@prev}
\item \textit{@exclude}
\item \textit{@select}
\end{itemize} 
\item \hyperref[TEI.att.global.analytic]{att.global.analytic}\begin{itemize}
\item \textit{@ana}
\end{itemize} 
\item \hyperref[TEI.att.global.facs]{att.global.facs}\begin{itemize}
\item \textit{@facs}
\end{itemize} 
\item \hyperref[TEI.att.global.change]{att.global.change}\begin{itemize}
\item \textit{@change}
\end{itemize} 
\item \hyperref[TEI.att.global.responsibility]{att.global.responsibility}\begin{itemize}
\item \textit{@cert}
\item \textit{@resp}
\end{itemize} 
\item \hyperref[TEI.att.global.source]{att.global.source}\begin{itemize}
\item \textit{@source}
\end{itemize} 
\end{itemize} 
\item \hyperref[TEI.att.declarable]{att.declarable}\begin{itemize}
\item \textit{@default}
\end{itemize} 
\end{itemize} \hfil\\[-10pt]\begin{sansreflist}
    \item[@eol]
  (end-of-line) indicates whether or not end-of-line hyphenation has been retained in a text.
\begin{reflist}
    \item[{Status}]
  Optional
    \item[{Datatype}]
  \hyperref[TEI.teidata.enumerated]{teidata.enumerated}
    \item[{Legal values are:}]
  \begin{description}

\item[{all}]all end-of-line hyphenation has been retained, even though the lineation of the original may not have been.
\item[{some}]end-of-line hyphenation has been retained in some cases.{[Default] }
\item[{hard}]all soft end-of-line hyphenation has been removed: any remaining end-of-line hyphenation should be retained.
\item[{none}]all end-of-line hyphenation has been removed: any remaining hyphenation occurred within the line.
\end{description} 
\end{reflist}  
\end{sansreflist}  
    \item[{Member of}]
  \hyperref[TEI.model.editorialDeclPart]{model.editorialDeclPart}
    \item[{Contained by}]
  
    \item[header: ]
   \hyperref[TEI.editorialDecl]{editorialDecl}
    \item[{May contain}]
  
    \item[core: ]
   \hyperref[TEI.p]{p}\par 
    \item[linking: ]
   \hyperref[TEI.ab]{ab}
    \item[{Example}]
  \leavevmode\bgroup\exampleFont \begin{shaded}\noindent\mbox{}{<\textbf{hyphenation}\hspace*{6pt}{eol}="{some}">}\mbox{}\newline 
\hspace*{6pt}{<\textbf{p}>}End-of-line hyphenation silently removed where appropriate{</\textbf{p}>}\mbox{}\newline 
{</\textbf{hyphenation}>}\end{shaded}\egroup 


