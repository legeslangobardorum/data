element place
{
   tei_att.global.attributes,
   tei_att.typed.attributes,
   tei_att.editLike.attributes,
   tei_att.sortable.attributes,
   (
      tei_model.headLike*,
      (
         tei_model.pLike*
       | (
            tei_model.labelLike          | tei_model.placeStateLike          | tei_model.eventLike          | tei_name         )*
      ),
      (
         tei_model.noteLike       | tei_model.biblLike       | tei_idno       | tei_ptr       | tei_linkGrp       | tei_link      )*,
      ( tei_model.placeLike | tei_listPlace )*
   )
}
\end{Verbatim}

