\hspace*{6pt}\hspace*{6pt}{<\textbf{date}>}1612.{</\textbf{date}>}\mbox{}\newline 
\hspace*{6pt}{</\textbf{docImprint}>}\mbox{}\newline 
{</\textbf{titlePage}>}\end{shaded}\egroup 


