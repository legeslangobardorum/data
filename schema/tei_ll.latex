    \item[{Example}]
  Taken from \textit{Wörterbuch der Deutschen Sprache. Veranstaltet und herausgegeben von Joachim Heinrich Campe. Vierter Theil. S - bis - T. (Braunschweig 1810. In der Schulbuchhandlung)}: 
\begin{quote}Treffen, v. unregelm. ... du triffst, ...\end{quote}
\leavevmode\bgroup\exampleFont \begin{shaded}\noindent\mbox{}{<\textbf{entry}>}\mbox{}\newline 
\hspace*{6pt}{<\textbf{form}\hspace*{6pt}{type}="{inflected}">}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{<\textbf{gramGrp}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}{<\textbf{per}\hspace*{6pt}{value}="{2}"/>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}{<\textbf{number}\hspace*{6pt}{value}="{singular}"/>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}{<\textbf{tns}\hspace*{6pt}{value}="{present}"/>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}{<\textbf{mood}\hspace*{6pt}{value}="{indicative}"/>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{</\textbf{gramGrp}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{<\textbf{form}\hspace*{6pt}{type}="{personalpronoun}">}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}{<\textbf{orth}>}du{</\textbf{orth}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{</\textbf{form}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{<\textbf{form}\hspace*{6pt}{type}="{headword}">}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}{<\textbf{orth}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}{<\textbf{oRef}>}triffst{</\textbf{oRef}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}{</\textbf{orth}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{</\textbf{form}>}\mbox{}\newline 
\hspace*{6pt}{</\textbf{form}>}\mbox{}\newline 
{</\textbf{entry}>}\end{shaded}\egroup 


