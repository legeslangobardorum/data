elation} \hyperref[TEI.residence]{residence} \hyperref[TEI.resp]{resp} \hyperref[TEI.seal]{seal} \hyperref[TEI.settlement]{settlement} \hyperref[TEI.sex]{sex} \hyperref[TEI.socecStatus]{socecStatus} \hyperref[TEI.sponsor]{sponsor} \hyperref[TEI.stamp]{stamp} \hyperref[TEI.state]{state} \hyperref[TEI.terrain]{terrain} \hyperref[TEI.time]{time} \hyperref[TEI.title]{title} \hyperref[TEI.trait]{trait} \hyperref[TEI.unitDecl]{unitDecl} \hyperref[TEI.unitDef]{unitDef}]
    \item[{Attributes}]
  \hfil\\[-10pt]\begin{sansreflist}
    \item[@when]
  supplies the value of the date or time in a standard form, e.g. yyyy-mm-dd.
\begin{reflist}
    \item[{Status}]
  Optional
    \item[{Datatype}]
  \hyperref[TEI.teidata.temporal.w3c]{teidata.temporal.w3c}
    \item[]Examples of W3C date, time, and date \& time formats.\exampleFont {<\textbf{p}>}\mbox{}\newline 
\hspace*{6pt}{<\textbf{date}\hspace*{6pt}{when}="{1945-10-24}">}24 Oct 45{</\textbf{date}>}\mbox{}\newline 
\hspace*{6pt}{<\textbf{date}\hspace*{6pt}{when}="{1996-09-24T07:25:00Z}">}September 24th, 1996 at 3:25 in the morning{</\textbf{date}>}\mbox{}\newline 
\hspace*{6pt}{<\textbf{time}\hspace*{6pt}{when}="{1999-01-04T20:42:00-05:00}">}Jan 4 1999 at 8 pm{</\textbf{time}>}\mbox{}\newline 
\hspace*{6pt}{<\textbf{time}\hspace*{6pt}{when}="{14:12:38}">}fourteen twelve and 38 seconds{</\textbf{time}>}\mbox{}\newline 
\hspace*{6pt}{<\textbf{date}\hspace*{6pt}{when}="{1962-10}">}October of 1962{</\textbf{date}>}\mbox{}\newline 
\hspace*{6pt}{<\textbf{date}\hspace*{6pt}{when}="{--06-12}">}June 12th{</\textbf{date}>}\mbox{}\newline 
\hspace*{6pt}{<\textbf{date}\hspace*{6pt}{when}="{---01}">}the first of the month{</\textbf{date}>}\mbox{}\newline 
\hspace*{6pt}{<\textbf{date}\hspace*{6pt}{when}="{--08}">}August{</\textbf{date}>}\mbox{}\newline 
\hspace*{6pt}{<\textbf{date}\hspace*{6pt}{when}="{2006}">}MMVI{</\textbf{date}>}\mbox{}\newline 
\hspace*{6pt}{<\textbf{date}\hspace*{6pt}{when}="{0056}">}AD 56{</\textbf{date}>}\mbox{}\newline 
\hspace*{6pt}{<\textbf{date}\hspace*{6pt}{when}="{-0056}">}56 BC{</\textbf{date}>}\mbox{}\newline 
{</\textbf{p}>}
    \item[]\exampleFont This list begins in\mbox{}\newline 
 the year 1632, more precisely on Trinity Sunday, i.e. the Sunday after\mbox{}\newline 
 Pentecost, in that year the\mbox{}\newline 
{<\textbf{date}\hspace*{6pt}{calendar}="{\#julian}"\mbox{}\newline 
\hspace*{6pt}{when}="{1632-06-06}">}27th of May (old style){</\textbf{date}>}.
    \item[]\exampleFont {<\textbf{opener}>}\mbox{}\newline 
\hspace*{6pt}{<\textbf{dateline}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{<\textbf{placeName}>}Dorchester, Village,{</\textbf{placeName}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{<\textbf{date}\hspace*{6pt}{when}="{1828-03-02}">}March 2d. 1828.{</\textbf{date}>}\mbox{}\newline 
\hspace*{6pt}{</\textbf{dateline}>}\mbox{}\newline 
\hspace*{6pt}{<\textbf{salute}>}To\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt} Mrs. Cornell,{</\textbf{salute}>} Sunday {<\textbf{time}\hspace*{6pt}{when}="{12:00:00}">}noon.{</\textbf{time}>}\mbox{}\newline 
{</\textbf{opener}>}
\end{reflist}  
    \item[@notBefore]
  specifies the earliest possible date for the event in standard form, e.g. yyyy-mm-dd.
\begin{reflist}
    \item[{Status}]
  Optional
    \item[{Datatype}]
  \hyperref[TEI.teidata.temporal.w3c]{teidata.temporal.w3c}
\end{reflist}  
    \item[@notAfter]
  specifies the latest possible date for the event in standard form, e.g. yyyy-mm-dd.
\begin{reflist}
    \item[{Status}]
  Optional
    \item[{Datatype}]
  \hyperref[TEI.teidata.temporal.w3c]{teidata.temporal.w3c}
\end{reflist}  
    \item[@from]
  indicates the starting point of the period in standard form, e.g. yyyy-mm-dd.
\begin{reflist}
    \item[{Status}]
  Optional
    \item[{Datatype}]
  \hyperref[TEI.teidata.temporal.w3c]{teidata.temporal.w3c}
\end{reflist}  
    \item[@to]
  indicates the ending point of the period in standard form, e.g. yyyy-mm-dd.
\begin{reflist}
    \item[{Status}]
  Optional
    \item[{Datatype}]
  \hyperref[TEI.teidata.temporal.w3c]{teidata.temporal.w3c}
\end{reflist}  
\end{sansreflist}  
    \item[{Schematron}]
   <sch:rule context="tei:*[@when]"> <sch:report role="nonfatal"  test="@notBefore|@notAfter|@from|@to">The @when attribute cannot be used with any other att.datable.w3c attributes.</sch:report> </sch:rule>
    \item[{Schematron}]
   <sch:rule context="tei:*[@from]"> <sch:report role="nonfatal"  test="@notBefore">The @from and @notBefore attributes cannot be used together.</sch:report> </sch:rule>
    \item[{Schematron}]
   <sch:rule context="tei:*[@to]"> <sch:report role="nonfatal"  test="@notAfter">The @to and @notAfter attributes cannot be used together.</sch:report> </sch:rule>
    \item[{Example}]
  \leavevmode\bgroup\exampleFont \begin{shaded}\noindent\mbox{}{<\textbf{date}\hspace*{6pt}{from}="{1863-05-28}"\hspace*{6pt}{to}="{1863-06-01}">}28 May through 1 June 1863{</\textbf{date}>}\end{shaded}\egroup 


    \item[{Note}]
  \par
The value of these attributes should be a normalized representation of the date, time, or combined date \& time intended, in any of the standard formats specified by XML Schema Part 2: Datatypes Second Edition, using the Gregorian calendar.\par
The most commonly-encountered format for the date portion of a temporal attribute is \texttt{yyyy-mm-dd}, but \texttt{yyyy}, \texttt{--mm}, \texttt{---dd}, \texttt{yyyy-mm}, or \texttt{--mm-dd} may also be used. For the time part, the form \texttt{hh:mm:ss} is used.\par
Note that this format does not currently permit use of the value 0000 to represent the year 1 BCE; instead the value -0001 should be used.
\end{reflist}  
\begin{reflist}
\item[]\begin{specHead}{TEI.att.datcat}{att.datcat}\index{att.datcat (attribute class)|oddindex}\index{datcat=@datcat!att.datcat (attribute class)|oddindex}\index{valueDatcat=@valueDatcat!att.datcat (attribute class)|oddindex}\index{targetDatcat=@targetDatcat!att.datcat (attribute class)|oddindex} provides attributes that are used to align XML elements or attributes with the appropriate Data Categories (DCs) defined by an external taxonomy, in this way establishing the identity of information containers and values, and providing means of interpreting them. [\xref{https://www.tei-c.org/release/doc/tei-p5-doc/en/html/DI.html\#DIMVLV}{10.5.2. Lexical View} \xref{https://www.tei-c.org/release/doc/tei-p5-doc/en/html/FS.html\#FSSY}{19.3. Other Atomic Feature Values}]\end{specHead} 
    \item[{Module}]
  tei
    \item[{Members}]
  \hyperref[TEI.att.lexicographic]{att.lexicographic}[\hyperref[TEI.case]{case} \hyperref[TEI.colloc]{colloc} \hyperref[TEI.def]{def} \hyperref[TEI.entryFree]{entryFree} \hyperref[TEI.etym]{etym} \hyperref[TEI.form]{form} \hyperref[TEI.gen]{gen} \hyperref[TEI.gram]{gram} \hyperref[TEI.gramGrp]{gramGrp} \hyperref[TEI.hom]{hom} \hyperref[TEI.hyph]{hyph} \hyperref[TEI.iType]{iType} \hyperref[TEI.lang]{lang} \hyperref[TEI.lbl]{lbl} \hyperref[TEI.mood]{mood} \hyperref[TEI.number]{number} \hyperref[TEI.oRef]{oRef} \hyperref[TEI.orth]{orth} \hyperref[TEI.pRef]{pRef} \hyperref[TEI.per]{per} \hyperref[TEI.pos]{pos} \hyperref[TEI.pron]{pron} \hyperref[TEI.re]{re} \hyperref[TEI.sense]{sense} \hyperref[TEI.subc]{subc} \hyperref[TEI.syll]{syll} \hyperref[TEI.tns]{tns} \hyperref[TEI.usg]{usg} \hyperref[TEI.xr]{xr}] \hyperref[TEI.att.segLike]{att.segLike}[\hyperref[TEI.c]{c} \hyperref[TEI.cl]{cl} \hyperref[TEI.m]{m} \hyperref[TEI.pc]{pc} \hyperref[TEI.phr]{phr} \hyperref[TEI.s]{s} \hyperref[TEI.seg]{seg} \hyperref[TEI.w]{w}] \hyperref[TEI.category]{category} \hyperref[TEI.tagUsage]{tagUsage} \hyperref[TEI.taxonomy]{taxonomy}
    \item[{Attributes}]
  \hfil\\[-10pt]\begin{sansreflist}
    \item[@datcat]
  provides a pointer to a definition of, and/or general information about, (a) an information container (element or attribute) or (b) a value of an information container (element content or attribute value), by referencing an external taxonomy or ontology. If {\itshape valueDatcat} is present in the immediate context, this attribute takes on role (a), while {\itshape valueDatcat} performs role (b).
\begin{reflist}
    \item[{Status}]
  Optional
    \item[{Datatype}]
  1–∞ occurrences of \hyperref[TEI.teidata.pointer]{teidata.pointer} separated by whitespace
\end{reflist}  
    \item[@valueDatcat]
  provides a definition of, and/or general information about a value of an information container (element content or attribute value), by reference to an external taxonomy or ontology. Used especially where a contrast with {\itshape datcat} is needed.
\begin{reflist}
    \item[{Status}]
  Optional
    \item[{Datatype}]
  1–∞ occurrences of \hyperref[TEI.teidata.pointer]{teidata.pointer} separated by whitespace
\end{reflist}  
    \item[@targetDatcat]
  provides a definition of, and/or general information about, information structure of an object referenced or modeled by the containing element, by reference to an external taxonomy or ontology. This attribute has the characteristics of the {\itshape datcat} attribute, except that it addresses not its containing element, but an object that is being referenced or modeled by its containing element.
\begin{reflist}
    \item[{Status}]
  Optional
    \item[{Datatype}]
  1–∞ occurrences of \hyperref[TEI.teidata.pointer]{teidata.pointer} separated by whitespace
\end{reflist}  
\end{sansreflist}  
    \item[{Example}]
  The example below presents the TEI encoding of the \xref{https://en.wikipedia.org/wiki/Name\%E2\%80\%93value_pair}{name-value pair} \texttt{<part of speech, common noun>}, where the name (key) ‘part of speech’ is abbreviated as ‘POS’, and the value, ‘common noun’ is symbolized by ‘NN’. The entire name-value pair is encoded by means of the element \texttt{<f>}. In TEI XML, that element acts as the container, labeled with the {\itshape name} attribute. Its contents may be complex or simple. In the case at hand, the content is the symbol ‘NN’.The {\itshape datcat} attribute relates the feature {\itshape name} (i.e., the key) to the data category ‘part of speech’, while the attribute {\itshape valueDatcat} relates the feature {\itshape value} to the data category \textit{common noun}. Both these data categories should be defined in an external and preferably open reference taxonomy or ontology.\leavevmode\bgroup\exampleFont \begin{shaded}\noindent\mbox{}{<\textbf{fs}>}\mbox{}\newline 
\hspace*{6pt}{<\textbf{f}\hspace*{6pt}{datcat}="{http://hdl.handle.net/11459/CCR\textunderscore C-396\textunderscore 5a972b93-2294-ab5c-a541-7c344c5f26c3}"\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{name}="{POS}">}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{<\textbf{symbol}\hspace*{6pt}{value}="{NN}"\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}{valueDatcat}="{http://hdl.handle.net/11459/CCR\textunderscore C-1256\textunderscore 7ec6083c-23d4-224d-6f94-eecbe6861545}"/>}\mbox{}\newline 
\hspace*{6pt}{</\textbf{f}>}\mbox{}\newline 
\textit{<!-- ... -->}\mbox{}\newline 
{</\textbf{fs}>}\end{shaded}\egroup 

‘NN’ is the symbol for common noun used e.g. in the \xref{http://ucrel.lancaster.ac.uk/claws7tags.html}{CLAWS-7 tagset} defined by the University Centre for Computer Corpus Research on Language at the University of Lancaster. The very same data category used for tagging an early version of the British National Corpus, and coming from the \xref{http://www.natcorp.ox.ac.uk/docs/c5spec.html}{BNC Basic (C5) tagset}, uses the symbol ‘NN0’ (rather than ‘NN’). Making these values semantically interoperable would be extremely difficult without a human expert if they were not anchored in a single point of an established reference taxonomy of morphosyntactic data categories. In the case at hand, the string ‘\xref{http://hdl.handle.net/11459/CCR_C-1256_7ec6083c-23d4-224d-6f94-eecbe6861545}{http://hdl.handle.net/11459/CCR\textunderscore C-1256\textunderscore 7ec6083c-23d4-224d-6f94-eecbe6861545}’ is both a persistent identifier of the data category in question, as well as a pointer to a shared definition of \textit{common noun}.While the symbols ‘NN’, ‘NN0’, and many others (often coming from languages other than English) are implicitly members of the container category ‘part of speech’, it is sometimes useful not to rely on such an implicit relationship but rather use an explicit identifier for that data category, to distinguish it from other morphosyntactic data categories, such as gender, tense, etc. For that purpose, the above example uses the {\itshape datcat} attribute to reference a definition of \textit{part of speech}. The reference taxonomy in this example is the \xref{https://www.clarin.eu/content/clarin-concept-registry}{CLARIN Concept Registry}.If the feature structure markup exemplified above is to be repeated many times in a single document, it is much more efficient to gather the persistent identifiers in a single place and to only reference them, implicitly or directly, from feature structure markup. The following example is much more concise than the one above and relies on the concepts of feature structure declaration and feature value library, discussed in chapter FS. \leavevmode\bgroup\exampleFont \begin{shaded}\noindent\mbox{}{<\textbf{fs}>}\mbox{}\newline 
\hspace*{6pt}{<\textbf{f}\hspace*{6pt}{fVal}="{\#commonNoun}"\hspace*{6pt}{name}="{POS}"/>}\mbox{}\newline 
\textit{<!-- ... -->}\mbox{}\newline 
{</\textbf{fs}>}\end{shaded}\egroup 

The assumption here is that the relevant feature values are collected in a place that the annotation document in question has access to — preferably, a single document per linguistic resource, for example an \texttt{<fsdDecl>} that is XIncluded as a sibling of \hyperref[TEI.text]{<text>} or a child of \hyperref[TEI.encodingDesc]{<encodingDesc>}; a \hyperref[TEI.taxonomy]{<taxonomy>} available resource-wide (e.g., in a shared header) is also an option.The example below presents an \texttt{<fvLib>} element that collects the relevant feature values (most of them omitted). At the same time, this example shows one way of encoding a \textit{tagset}, i.e., an established inventory of values of (in the case at hand) morphosyntactic categories. \leavevmode\bgroup\exampleFont \begin{shaded}\noindent\mbox{}{<\textbf{fvLib}\hspace*{6pt}{n}="{POS values}">}\mbox{}\newline 
\hspace*{6pt}{<\textbf{symbol}\hspace*{6pt}{datcat}="{http://hdl.handle.net/11459/CCR\textunderscore C-396\textunderscore 5a972b93-2294-ab5c-a541-7c344c5f26c3}"\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{value}="{NN}"\hspace*{6pt}{xml:id}="{commonNoun}"/>}\mbox{}\newline 
\hspace*{6pt}{<\textbf{symbol}\hspace*{6pt}{datcat}="{http://hdl.handle.net/11459/CCR\textunderscore C-1371\textunderscore fbebd9ec-a7f4-9a36-d6e9-88ee16b944ae}"\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{value}="{NP}"\hspace*{6pt}{xml:id}="{properNoun}"/>}\mbox{}\newline 
\textit{<!-- ... -->}\mbox{}\newline 
{</\textbf{fvLib}>}\end{shaded}\egroup 

Note that these Guidelines do not prescribe a specific choice between {\itshape datcat} and {\itshape valueDatcat} in such cases. The former is the generic way of referencing a data category, whereas the latter is more specific, in that it references a data category that represents a value. The choice between them comes into play where a single element — or a tight element complex, such as the \texttt{<f>}/\texttt{<symbol>} complex illustrated above — make it necessary or useful to distinguish between the container data category and its value.
    \item[{Example}]
  In the context of dictionaries designed with semantic interoperability in mind, the following example ensures that the \hyperref[TEI.pos]{<pos>} element is interpreted as the same information container as in the case of the example of <f name="POS"> above.\leavevmode\bgroup\exampleFont \begin{shaded}\noindent\mbox{}{<\textbf{gramGrp}>}\mbox{}\newline 
\hspace*{6pt}{<\textbf{pos}\hspace*{6pt}{datcat}="{http://hdl.handle.net/11459/CCR\textunderscore C-396\textunderscore 5a972b93-2294-ab5c-a541-7c344c5f26c3}"\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{valueDatcat}="{http://hdl.handle.net/11459/CCR\textunderscore C-1256\textunderscore 7ec6083c-23d4-224d-6f94-eecbe6861545}">}NN{</\textbf{pos}>}\mbox{}\newline 
{</\textbf{gramGrp}>}\end{shaded}\egroup 

Efficiency of this type of interoperable markup demands that the references to the particular data categories should best be provided in a single place within the dictionary (or a single place within the project), rather than being repeated inside every entry. For the container elements, this can be achieved at the level of \hyperref[TEI.tagUsage]{<tagUsage>}, although here, the {\itshape valueDatcat} attribute should be used, because it is not the \hyperref[TEI.tagUsage]{<tagUsage>} element that is associated with the relevant data category, but rather the element \hyperref[TEI.pos]{<pos>} (or \hyperref[TEI.case]{<case>}, etc.) that is described by \hyperref[TEI.tagUsage]{<tagUsage>}: \leavevmode\bgroup\exampleFont \begin{shaded}\noindent\mbox{}{<\textbf{tagsDecl}\hspace*{6pt}{partial}="{true}">}\mbox{}\newline 
\textit{<!-- ... -->}\mbox{}\newline 
\hspace*{6pt}{<\textbf{namespace}\hspace*{6pt}{name}="{http://www.tei-c.org/ns/1.0}">}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{<\textbf{tagUsage}\hspace*{6pt}{gi}="{pos}"\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}{targetDatcat}="{http://hdl.handle.net/11459/CCR\textunderscore C-396\textunderscore 5a972b93-2294-ab5c-a541-7c344c5f26c3}">}Contains the part of speech.{</\textbf{tagUsage}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{<\textbf{tagUsage}\hspace*{6pt}{gi}="{case}"\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}{targetDatcat}="{http://hdl.handle.net/11459/CCR\textunderscore C-1840\textunderscore 9f4e319c-f233-6c90-9117-7270e215f039}">}Contains information about the grammatical case that the described form is inflected for.{</\textbf{tagUsage}>}\mbox{}\newline 
\textit{<!-- ... -->}\mbox{}\newline 
\hspace*{6pt}{</\textbf{namespace}>}\mbox{}\newline 
{</\textbf{tagsDecl}>}\end{shaded}\egroup 

Another possibility is to shorten the URIs by means of the \hyperref[TEI.prefixDef]{<prefixDef>} mechanism, as illustrated below: \leavevmode\bgroup\exampleFont \begin{shaded}\noindent\mbox{}{<\textbf{listPrefixDef}>}\mbox{}\newline 
\hspace*{6pt}{<\textbf{prefixDef}\hspace*{6pt}{ident}="{ccr}"\hspace*{6pt}{matchPattern}="{pos}"\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{replacementPattern}="{http://hdl.handle.net/11459/CCR\textunderscore C-396\textunderscore 5a972b93-2294-ab5c-a541-7c344c5f26c3}"/>}\mbox{}\newline 
\hspace*{6pt}{<\textbf{prefixDef}\hspace*{6pt}{ident}="{ccr}"\hspace*{6pt}{matchPattern}="{adj}"\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{replacementPattern}="{http://hdl.handle.net/11459/CCR\textunderscore C-1230\textunderscore 23653c21-fca1-edf8-fd7c-3df2d6499157}"/>}\mbox{}\newline 
{</\textbf{listPrefixDef}>}\mbox{}\newline 
\textit{<!-- ... -->}\mbox{}\newline 
{<\textbf{entry}>}\mbox{}\newline 
\textit{<!--...-->}\mbox{}\newline 
\hspace*{6pt}{<\textbf{form}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{<\textbf{orth}>}isotope{</\textbf{orth}>}\mbox{}\newline 
\hspace*{6pt}{</\textbf{form}>}\mbox{}\newline 
\hspace*{6pt}{<\textbf{gramGrp}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{<\textbf{pos}\hspace*{6pt}{datcat}="{ccr:pos}"\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}{valueDatcat}="{ccr:adj}">}adj{</\textbf{pos}>}\mbox{}\newline 
\hspace*{6pt}{</\textbf{gramGrp}>}\mbox{}\newline 
\textit{<!--...-->}\mbox{}\newline 
{</\textbf{entry}>}\end{shaded}\egroup 

This mechanism creates implications that are not always wanted, among others, in the case at hand, suggesting that the identifiers ‘pos’ and ‘adj’ belong to a namespace associated with the CLARIN Concept Repository (CCR), whereas that is solely a shorthand mechanism whose scope is the current resource. Documenting this clearly in the header of the dictionary is therefore advised.Yet another possibility is to associate the information about the relationship between a TEI markup element and the data category that it is intended to model already at the level of modeling the dictionary resource, that is, at the level of the ODD, in the \texttt{<equiv>} element that is a child of \texttt{<elementSpec>} or \texttt{<attDef>}.
    \item[{Example}]
  The \hyperref[TEI.taxonomy]{<taxonomy>} element is a handy tool for encoding taxonomies that are later referenced by \textsf{\hyperref[TEI.att.datcat]{att.datcat}} attributes, but it can also act as an intermediary device, for example holding a fragment of an external taxonomy (or ‘flattening’ an external ontology) that is relevant to the project or document at hand. (It is also imaginable that, for the purpose of the project at hand, the local \hyperref[TEI.taxonomy]{<taxonomy>} element combines vocabularies that originate from more than one external taxonomy or ontology.) In such cases, the \hyperref[TEI.taxonomy]{<taxonomy>} creates a local layer of indirection: the \textsf{\hyperref[TEI.att.datcat]{att.datcat}} attributes internal to the resource may reference the \hyperref[TEI.category]{<category>} elements stored in the header (as well as the \hyperref[TEI.taxonomy]{<taxonomy>} element itself), whereas these same \hyperref[TEI.category]{<category>} and \hyperref[TEI.taxonomy]{<taxonomy>} elements use \textsf{\hyperref[TEI.att.datcat]{att.datcat}} attributes to reference the original taxonomy or ontology.\leavevmode\bgroup\exampleFont \begin{shaded}\noindent\mbox{}{<\textbf{encodingDesc}>}\mbox{}\newline 
\textit{<!-- ... -->}\mbox{}\newline 
\hspace*{6pt}{<\textbf{classDecl}>}\mbox{}\newline 
\textit{<!-- ... -->}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{<\textbf{taxonomy}\hspace*{6pt}{datcat}="{https://universaldependencies.org/u/dep/index.html}"\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}{xml:id}="{UD-SYN}">}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}{<\textbf{desc}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}{<\textbf{term}>}UD syntactic relations{</\textbf{term}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}{</\textbf{desc}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}{<\textbf{category}\hspace*{6pt}{valueDatcat}="{https://universaldependencies.org/u/dep/acl.html}"\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}{xml:id}="{acl}">}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}{<\textbf{catDesc}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}{<\textbf{term}>}acl{</\textbf{term}>}: Clausal modifier of noun (adjectival clause){</\textbf{catDesc}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}{</\textbf{category}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}{<\textbf{category}\hspace*{6pt}{valueDatcat}="{https://universaldependencies.org/u/dep/acl-relcl.html}"\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}{xml:id}="{acl\textunderscore relcl}">}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}{<\textbf{catDesc}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}{<\textbf{term}>}acl:relcl{</\textbf{term}>}: relative clause modifier{</\textbf{catDesc}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}{</\textbf{category}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}{<\textbf{category}\hspace*{6pt}{valueDatcat}="{https://universaldependencies.org/u/dep/advcl.html}"\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}{xml:id}="{advcl}">}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}{<\textbf{catDesc}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}{<\textbf{term}>}advcl{</\textbf{term}>}: Adverbial clause modifier{</\textbf{catDesc}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}{</\textbf{category}>}\mbox{}\newline 
\textit{<!-- ... -->}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{</\textbf{taxonomy}>}\mbox{}\newline 
\hspace*{6pt}{</\textbf{classDecl}>}\mbox{}\newline 
{</\textbf{encodingDesc}>}\end{shaded}\egroup 

The above fragment was excerpted from the GB subset of the \xref{https://github.com/clarin-eric/ParlaMint}{ParlaMint project} in April 2023, and enriched with \textsf{\hyperref[TEI.att.datcat]{att.datcat}} attributes for the purpose of illustrating the mechanism described here.Note that, in the ideal case, the values of \textsf{\hyperref[TEI.att.datcat]{att.datcat}} attributes should be persistent identifiers, and that the addressing scheme of Universal Dependencies is treated here as persistent for the sake of illustration. Note also that the contrast between {\itshape datcat} used on \hyperref[TEI.taxonomy]{<taxonomy>} on the one hand, and the {\itshape valueDatcat} used on \hyperref[TEI.category]{<category>} on the other, is not mandatory: both kinds of relations could be encoded by means of the generic {\itshape datcat} attribute, but using the former for the container and the latter for the content is more user-friendly.
    \item[{Example}]
  The {\itshape targetDatcat} attribute is designed to be used in, e.g., feature structure declarations, and is analogous to the {\itshape targetLang} attribute of the \textsf{att.pointing} class, in that it describes the object that is being referenced, rather than the referencing object.\leavevmode\bgroup\exampleFont \begin{shaded}\noindent\mbox{}{<\textbf{fDecl}\hspace*{6pt}{name}="{POS}"\mbox{}\newline 
\hspace*{6pt}{targetDatcat}="{http://hdl.handle.net/11459/CCR\textunderscore C-396\textunderscore 5a972b93-2294-ab5c-a541-7c344c5f26c3}">}\mbox{}\newline 
\hspace*{6pt}{<\textbf{fDescr}>}part of speech (morphosyntactic category){</\textbf{fDescr}>}\mbox{}\newline 
\hspace*{6pt}{<\textbf{vRange}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{<\textbf{vAlt}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}{<\textbf{symbol}\hspace*{6pt}{datcat}="{http://hdl.handle.net/11459/CCR\textunderscore C-1256\textunderscore 7ec6083c-23d4-224d-6f94-eecbe6861545}"\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}{value}="{NN}"/>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}{<\textbf{symbol}\hspace*{6pt}{datcat}="{http://hdl.handle.net/11459/CCR\textunderscore C-1371\textunderscore fbebd9ec-a7f4-9a36-d6e9-88ee16b944ae}"\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}{value}="{NP}"/>}\mbox{}\newline 
\textit{<!-- ... -->}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{</\textbf{vAlt}>}\mbox{}\newline 
\hspace*{6pt}{</\textbf{vRange}>}\mbox{}\newline 
{</\textbf{fDecl}>}\end{shaded}\egroup 

Above, the \texttt{<fDecl>} uses {\itshape targetDatcat}, because if it were to use {\itshape datcat}, it would be asserting that it is an instance of the container data category \textit{part of speech}, whereas it is not — it models a container (\texttt{<f>}) that encodes a part of speech. Note also that it is the \texttt{<f>} that is modeled above, not its values, which are used as direct references to data categories; hence the use of {\itshape datcat} in the \texttt{<symbol>} element.
    \item[{Example}]
  The \textsf{\hyperref[TEI.att.datcat]{att.datcat}} attributes can be used for any sort of taxonomies. The example below illustrates their usefulness for describing usage domain labels in dictionaries on the example of the \textit{Diccionario da Lingua Portugueza} by António de Morais Silva, retro-digitised in the \xref{https://mordigital.fcsh.unl.pt/en/homepage/}{MORDigital project}.\leavevmode\bgroup\exampleFont \begin{shaded}\noindent\mbox{}\mbox{}\newline 
\textit{<!--  in the dictionary header    -->}{<\textbf{encodingDesc}>}\mbox{}\newline 
\hspace*{6pt}{<\textbf{classDecl}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{<\textbf{taxonomy}\hspace*{6pt}{xml:id}="{domains}">}\mbox{}\newline 
\textit{<!--...-->}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}{<\textbf{category}\hspace*{6pt}{xml:id}="{domain.medical\textunderscore and\textunderscore health\textunderscore sciences}">}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}{<\textbf{catDesc}\hspace*{6pt}{xml:lang}="{en}">}Medical and Health Sciences{</\textbf{catDesc}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}{<\textbf{catDesc}\hspace*{6pt}{xml:lang}="{pt}">}Ciências Médicas e da Saúde{</\textbf{catDesc}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}{<\textbf{category}\hspace*{6pt}{valueDatcat}="{https://vocabs.rossio.fcsh.unl.pt/pub/morais\textunderscore domains/pt/page/0025}"\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}{xml:id}="{domain.medical\textunderscore and\textunderscore health\textunderscore sciences.medicine}">}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}{<\textbf{catDesc}\hspace*{6pt}{xml:lang}="{en}">}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}{<\textbf{term}>}Medicine{</\textbf{term}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}{<\textbf{gloss}>}\mbox{}\newline 
\textit{<!--...-->}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}{</\textbf{gloss}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}{</\textbf{catDesc}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}{<\textbf{catDesc}\hspace*{6pt}{xml:lang}="{pt}">}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}{<\textbf{term}>}Medicina{</\textbf{term}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}{<\textbf{gloss}>}\mbox{}\newline 
\textit{<!--...-->}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}{</\textbf{gloss}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}{</\textbf{catDesc}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}{</\textbf{category}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}{</\textbf{category}>}\mbox{}\newline 
\textit{<!--...-->}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{</\textbf{taxonomy}>}\mbox{}\newline 
\hspace*{6pt}{</\textbf{classDecl}>}\mbox{}\newline 
{</\textbf{encodingDesc}>}\mbox{}\newline 
\textit{<!-- \newline
            inside an <entry> element: -->}\mbox{}\newline 
{<\textbf{usg}\hspace*{6pt}{type}="{domain}"\mbox{}\newline 
\hspace*{6pt}{valueDatcat}="{\#domain.medical\textunderscore and\textunderscore health\textunderscore sciences.medicine}">}Med.{</\textbf{usg}>}\end{shaded}\egroup 

In the Morais dictionary, the relevant domain labels are in the header, getting referenced inside the dictionary, from \hyperref[TEI.usg]{<usg>} elements. The vocabulary used for dictionary-internal labelling is in turn anchored in the \xref{https://vocabs.rossio.fcsh.unl.pt/pub/en/about}{MorDigital controlled vocabulary service} of the NOVA University of Lisbon – School of Social Sciences and Humanities (NOVA FCSH).
    \item[{Note}]
  \par
The TEI Abstract Model can be expressed as a hierarchy of attribute-value matrices (AVMs) of various types and of various levels of complexity, nested or grouped in various ways. At the most abstract level, an AVM consists of an information container and the value (contents) of that container.\par
A simple example of an XML serialization of such structures is, on the one hand, the opening and closing tags that delimit and name the container, and, on the other, the content enclosed by the two tags that constitues the value. An analogous example is an attribute name and the value of that attribute.\par
In a TEI XML example of two equivalent serializations expressing the name-value pair \texttt{<part-of-speech,common-noun>}, namely \texttt{<pos>commonNoun</pos>} and \texttt{pos="common-noun"}, one would classify the element \hyperref[TEI.pos]{<pos>} and the attribute {\itshape pos} as containers (mapping onto the first member of the relevant name-value pair), while the character data content of \hyperref[TEI.pos]{<pos>} or the value of {\itshape pos} would be seen as mapping onto the second member of the pair.\par
The \textsf{\hyperref[TEI.att.datcat]{att.datcat}} class provides means of addressing the containers and their values, while at the same time providing a way to interpret them in the context of external taxonomies or ontologies. Aligning e.g. both the \hyperref[TEI.pos]{<pos>} element and the {\itshape pos} attribute with the same value of an external reference point (i.e., an entry in an agreed taxonomy) affirms the identity of the concept serialised by both the element container and the attribute container, and optionally provides a definition of that concept (in the case at hand, the concept \textit{part of speech}).\par
The value of the \textsf{\hyperref[TEI.att.datcat]{att.datcat}} attributes should be a PID (persistent identifier) that points to a specific — and, ideally, shared — taxonomy or ontology. Among the resources that can, to a lesser or greater extent, be used as inventories of (more or less) standardized linguistic categories are the GOLD ontology, \xref{https://www.clarin.eu/content/clarin-concept-registry}{CLARIN CCR}, \xref{https://github.com/acoli-repo/olia}{OLiA}, or \xref{https://datcatinfo.net/}{TermWeb's DatCatInfo}, and also the \xref{https://universaldependencies.org/}{Universal Dependencies} inventory, on the assumption that its URIs are going to persist. It is imaginable that a project may choose to address a local taxonomy store instead, but this risks losing the advantage of interchangeability with other projects.\par
Historically, {\itshape datcat} and {\itshape valueDatcat} originate from the (now obsolete) ISO 12620:2009 standard, describing the data model and procedures for a Data Category Registry (DCR). The current version of that standard, ISO 12620-1, does not standardize the serialization of pointers, merely mentioning the TEI \textsf{\hyperref[TEI.att.datcat]{att.datcat}} as an example.\par
Note that no constraint prevents the occurrence of a combination of \textsf{\hyperref[TEI.att.datcat]{att.datcat}} attributes: the \texttt{<fDecl>} element, which is a natural bearer of the {\itshape targetDatcat} attribute, is an instance of a specific modeling element, and, in principle, could be semantically fixed by an appropriate reference taxonomy of modeling devices.
\end{reflist}  
\begin{reflist}
\item[]\begin{specHead}{TEI.att.declarable}{att.declarable}\index{att.declarable (attribute class)|oddindex}\index{default=@default!att.declarable (attribute class)|oddindex} provides attributes for those elements in the TEI header which may be independently selected by means of the special purpose {\itshape decls} attribute. [\xref{https://www.tei-c.org/release/doc/tei-p5-doc/en/html/CC.html\#CCAS}{16.3. Associating Contextual Information with a Text}]\end{specHead} 
    \item[{Module}]
  tei
    \item[{Members}]
  \hyperref[TEI.availability]{availability} \hyperref[TEI.bibl]{bibl} \hyperref[TEI.biblFull]{biblFull} \hyperref[TEI.biblStruct]{biblStruct} \hyperref[TEI.correction]{correction} \hyperref[TEI.correspDesc]{correspDesc} \hyperref[TEI.editorialDecl]{editorialDecl} \hyperref[TEI.geoDecl]{geoDecl} \hyperref[TEI.hyphenation]{hyphenation} \hyperref[TEI.interpretation]{interpretation} \hyperref[TEI.langUsage]{langUsage} \hyperref[TEI.listApp]{listApp} \hyperref[TEI.listBibl]{listBibl} \hyperref[TEI.listEvent]{listEvent} \hyperref[TEI.listNym]{listNym} \hyperref[TEI.listObject]{listObject} \hyperref[TEI.listOrg]{listOrg} \hyperref[TEI.listPerson]{listPerson} \hyperref[TEI.listPlace]{listPlace} \hyperref[TEI.normalization]{normalization} \hyperref[TEI.projectDesc]{projectDesc} \hyperref[TEI.punctuation]{punctuation} \hyperref[TEI.quotation]{quotation} \hyperref[TEI.refsDecl]{refsDecl} \hyperref[TEI.samplingDecl]{samplingDecl} \hyperref[TEI.segmentation]{segmentation} \hyperref[TEI.seriesStmt]{seriesStmt} \hyperref[TEI.sourceDesc]{sourceDesc} \hyperref[TEI.stdVals]{stdVals} \hyperref[TEI.styleDefDecl]{styleDefDecl} \hyperref[TEI.textClass]{textClass} \hyperref[TEI.xenoData]{xenoData}
    \item[{Attributes}]
  \hfil\\[-10pt]\begin{sansreflist}
    \item[@default]
  indicates whether or not this element is selected by default when its parent is selected.
\begin{reflist}
    \item[{Status}]
  Optional
    \item[{Datatype}]
  \hyperref[TEI.teidata.truthValue]{teidata.truthValue}
    \item[{Legal values are:}]
  \begin{description}

\item[{true}]This element is selected if its parent is selected
\item[{false}]This element can only be selected explicitly, unless it is the only one of its kind, in which case it is selected if its parent is selected.{[Default] }
\end{description} 
\end{reflist}  
\end{sansreflist}  
    \item[{Note}]
  \par
The rules governing the association of declarable elements with individual parts of a TEI text are fully defined in chapter \xref{https://www.tei-c.org/release/doc/tei-p5-doc/en/html/CC.html\#CCAS}{16.3. Associating Contextual Information with a Text}. Only one element of a particular type may have a {\itshape default} attribute with a value of true.
\end{reflist}  
