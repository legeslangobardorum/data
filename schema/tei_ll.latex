{<\textbf{certainty}\hspace*{6pt}{assertedValue}="{\#a1}"\hspace*{6pt}{degree}="{0.5}"\mbox{}\newline 
\hspace*{6pt}{given}="{\#c1}"\hspace*{6pt}{locus}="{start}"\hspace*{6pt}{target}="{\#SYB}"/>}\end{shaded}\egroup 


