\begin{reflist}
\item[]\begin{specHead}{TEI.refState}{<refState> }(reference state) specifies one component of a canonical reference defined by the milestone method. [\xref{https://www.tei-c.org/release/doc/tei-p5-doc/en/html/HD.html\#HD54M}{2.3.6.3. Milestone Method} \xref{https://www.tei-c.org/release/doc/tei-p5-doc/en/html/HD.html\#HD54}{2.3.6. The Reference System Declaration}]\end{specHead} 
    \item[{Module}]
  header
