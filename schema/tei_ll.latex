\hspace*{6pt}{<\textbf{quote}\hspace*{6pt}{xml:lang}="{mix}">}Ka'an yu tsa'a Pedro.{</\textbf{quote}>}\mbox{}\newline 
\hspace*{6pt}{<\textbf{media}\hspace*{6pt}{mimeType}="{audio/wav}"\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{url}="{soundfiles-gen:S\textunderscore speak\textunderscore 1s\textunderscore on\textunderscore behalf\textunderscore of\textunderscore Pedro\textunderscore 01\textunderscore 02\textunderscore 03\textunderscore TS.wav}"/>}\mbox{}\newline 
\hspace*{6pt}{<\textbf{cit}\hspace*{6pt}{type}="{translation}">}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{<\textbf{quote}\hspace*{6pt}{xml:lang}="{en}">}I'm speaking on behalf of Pedro.{</\textbf{quote}>}\mbox{}\newline 
\hspace*{6pt}{</\textbf{cit}>}\mbox{}\newline 
\hspace*{6pt}{<\textbf{cit}\hspace*{6pt}{type}="{translation}">}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{<\textbf{quote}\hspace*{6pt}{xml:lang}="{es}">}Estoy hablando de parte de Pedro.{</\textbf{quote}>}\mbox{}\newline 
\hspace*{6pt}{</\textbf{cit}>}\mbox{}\newline 
{</\textbf{cit}>}\end{shaded}\egroup 


