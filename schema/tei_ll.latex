<content>
 <macroRef key="macro.specialPara"/>
</content>
    
\end{Verbatim}

    \item[{Schema Declaration}]
  \mbox{}\hfill\\[-10pt]\begin{Verbatim}[fontsize=\small]
element q
{
   tei_att.global.attributes,
   tei_att.ascribed.directed.attributes,
   tei_att.cmc.attributes,
   attribute type
   {
      "spoken"
    | "thought"
    | "written"
    | "soCalled"
    | "foreign"
    | "distinct"
    | "term"
    | "emph"
    | "mentioned"
   }?,
   tei_macro.specialPara}
\end{Verbatim}

\end{reflist}  \index{quotation=<quotation>|oddindex}\index{marks=@marks!<quotation>|oddindex}
\begin{reflist}
\item[]\begin{specHead}{TEI.quotation}{<quotation> }(quotation) specifies editorial practice adopted with respect to quotation marks in the original. [\xref{https://www.tei-c.org/release/doc/tei-p5-doc/en/html/HD.html\#HD53}{2.3.3. The Editorial Practices Declaration} \xref{https://www.tei-c.org/release/doc/tei-p5-doc/en/html/CC.html\#CCAS2}{16.3.2. Declarable Elements}]\end{specHead} 
    \item[{Module}]
  header
    \item[{Attributes}]
  \begin{itemize}
\item \hyperref[TEI.att.global]{att.global}\begin{itemize}
\item \textit{@xml:id}
\item \textit{@n}
\item \textit{@xml:lang}
\item \textit{@xml:base}
\item \textit{@xml:space}
\end{itemize} \begin{itemize}
\item \hyperref[TEI.att.global.rendition]{att.global.rendition}\begin{itemize}
\item \textit{@rend}
\item \textit{@style}
\item \textit{@rendition}
\end{itemize} 
\item \hyperref[TEI.att.global.linking]{att.global.linking}\begin{itemize}
\item \textit{@corresp}
\item \textit{@synch}
\item \textit{@sameAs}
\item \textit{@copyOf}
\item \textit{@next}
\item \textit{@prev}
\item \textit{@exclude}
\item \textit{@select}
\end{itemize} 
\item \hyperref[TEI.att.global.analytic]{att.global.analytic}\begin{itemize}
\item \textit{@ana}
\end{itemize} 
\item \hyperref[TEI.att.global.facs]{att.global.facs}\begin{itemize}
\item \textit{@facs}
\end{itemize} 
\item \hyperref[TEI.att.global.change]{att.global.change}\begin{itemize}
\item \textit{@change}
\end{itemize} 
\item \hyperref[TEI.att.global.responsibility]{att.global.responsibility}\begin{itemize}
\item \textit{@cert}
\item \textit{@resp}
\end{itemize} 
\item \hyperref[TEI.att.global.source]{att.global.source}\begin{itemize}
\item \textit{@source}
\end{itemize} 
\end{itemize} 
