nce} \hyperref[TEI.resp]{resp} \hyperref[TEI.seal]{seal} \hyperref[TEI.settlement]{settlement} \hyperref[TEI.sex]{sex} \hyperref[TEI.socecStatus]{socecStatus} \hyperref[TEI.sponsor]{sponsor} \hyperref[TEI.stamp]{stamp} \hyperref[TEI.state]{state} \hyperref[TEI.terrain]{terrain} \hyperref[TEI.time]{time} \hyperref[TEI.title]{title} \hyperref[TEI.trait]{trait} \hyperref[TEI.unitDecl]{unitDecl} \hyperref[TEI.unitDef]{unitDef}
