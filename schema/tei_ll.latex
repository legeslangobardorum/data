element notatedMusic
{
   tei_att.global.attributes,
   tei_att.placement.attributes,
   tei_att.typed.attributes,
   tei_att.cmc.attributes,
   (
      tei_model.labelLike    | tei_model.ptrLike    | tei_graphic    | binaryObject    | tei_seg   )*
}
\end{Verbatim}

