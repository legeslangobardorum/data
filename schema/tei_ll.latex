\item \textit{@resp}
\end{itemize} 
\item \hyperref[TEI.att.global.source]{att.global.source}\begin{itemize}
\item \textit{@source}
\end{itemize} 
\end{itemize} 
\item \hyperref[TEI.att.datcat]{att.datcat}\begin{itemize}
