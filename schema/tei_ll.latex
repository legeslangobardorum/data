\hspace*{6pt}{<\textbf{persName}\hspace*{6pt}{xml:lang}="{grc}">}Ἑρμαφρόδιτος{</\textbf{persName}>}\mbox{}\newline 
{</\textbf{person}>}\end{shaded}\egroup 


