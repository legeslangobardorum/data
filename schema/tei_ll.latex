element listChange
{
   tei_att.global.attributes,
   tei_att.sortable.attributes,
   tei_att.typed.attributes,
   attribute ordered { text }?,
   ( tei_desc*, ( tei_listChange | tei_change )+ )
}
\end{Verbatim}

