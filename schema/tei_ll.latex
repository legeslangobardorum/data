\hspace*{6pt}{</\textbf{w}>}\mbox{}\newline 
\hspace*{6pt}{<\textbf{m}\hspace*{6pt}{type}="{suffix}">}able{</\textbf{m}>}\mbox{}\newline 
{</\textbf{w}>}\end{shaded}\egroup 


