element binding
{
   tei_att.global.attributes,
   tei_att.datable.attributes,
   attribute calendar { list { + } }?,
   attribute contemporary { text }?,
   ( tei_model.pLike | tei_condition | tei_decoNote )+
}
\end{Verbatim}

