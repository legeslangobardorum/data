\item \textit{@rend}
\item \textit{@style}
\item \textit{@rendition}
\end{itemize} 
\item \hyperref[TEI.att.global.linking]{att.global.linking}\begin{itemize}
\item \textit{@corresp}
\item \textit{@synch}
\item \textit{@sameAs}
\item \textit{@copyOf}
\item \textit{@next}
\item \textit{@prev}
\item \textit{@exclude}
\item \textit{@select}
\end{itemize} 
\item \hyperref[TEI.att.global.analytic]{att.global.analytic}\begin{itemize}
\item \textit{@ana}
\end{itemize} 
\item \hyperref[TEI.att.global.facs]{att.global.facs}\begin{itemize}
\item \textit{@facs}
\end{itemize} 
\item \hyperref[TEI.att.global.change]{att.global.change}\begin{itemize}
\item \textit{@change}
\end{itemize} 
\item \hyperref[TEI.att.global.responsibility]{att.global.responsibility}\begin{itemize}
\item \textit{@cert}
\item \textit{@resp}
\end{itemize} 
\item \hyperref[TEI.att.global.source]{att.global.source}\begin{itemize}
\item \textit{@source}
\end{itemize} 
\end{itemize} 
\item \hyperref[TEI.att.citeStructurePart]{att.citeStructurePart}\begin{itemize}
\item \textit{@use}
\end{itemize} 
\end{itemize} \hfil\\[-10pt]\begin{sansreflist}
    \item[@delim]
  (delimiter) supplies a delimiting string preceding the structural component.
\begin{reflist}
    \item[{Status}]
  Optional
    \item[{Datatype}]
  \xref{https://www.w3.org/TR/xmlschema-2/\#string}{string}
    \item[{Note}]
  \par
{\itshape delim} must contain at least one character.
\end{reflist}  
    \item[@match]
  (match) supplies an XPath selection pattern using the syntax defined in XSLT3 which identifies a set of nodes which are citable structural components. The expression may be absolute (beginning with \texttt{/}) or relative. {\itshape match} on a \hyperref[TEI.citeStructure]{<citeStructure>} without a \hyperref[TEI.citeStructure]{<citeStructure>} parent must be an absolute XPath. If it is relative, its context is set by the {\itshape match} of the parent \hyperref[TEI.citeStructure]{<citeStructure>}.
\begin{reflist}
    \item[{Status}]
  Required
    \item[{Datatype}]
  \hyperref[TEI.teidata.xpath]{teidata.xpath}
    \item[{Schematron}]
   <sch:rule context="tei:citeStructure[not(parent::tei:citeStructure)]"> <sch:assert test="starts-with(@match,'/')">An XPath in @match on the outer <sch:name/> must start with '/'.</sch:assert> </sch:rule>
    \item[{Schematron}]
   <sch:rule context="tei:citeStructure[parent::tei:citeStructure]"> <sch:assert test="not(starts-with(@match,'/'))">An XPath in @match must not start with '/' except on the outer <sch:name/>.</sch:assert> </sch:rule>
\end{reflist}  
    \item[@unit]
  (unit) describes the structural unit indicated by the \hyperref[TEI.citeStructure]{<citeStructure>}.
\begin{reflist}
    \item[{Status}]
  Optional
    \item[{Datatype}]
  \hyperref[TEI.teidata.enumerated]{teidata.enumerated}
    \item[{Sample values include:}]
  \begin{description}

\item[{book}]
\item[{chapter}]
\item[{entry}]
\item[{poem}]
\item[{letter}]
\item[{line}]
\item[{section}]
\item[{verse}]
\item[{volume}]
\end{description} 
\end{reflist}  
\end{sansreflist}  
    \item[{Contained by}]
  
    \item[header: ]
   \hyperref[TEI.citeStructure]{citeStructure} \hyperref[TEI.refsDecl]{refsDecl}
    \item[{May contain}]
  
    \item[core: ]
   \hyperref[TEI.desc]{desc}\par 
    \item[header: ]
   \hyperref[TEI.citeData]{citeData} \hyperref[TEI.citeStructure]{citeStructure}
    \item[{Example}]
  \leavevmode\bgroup\exampleFont \begin{shaded}\noindent\mbox{}{<\textbf{citeStructure}\hspace*{6pt}{match}="{//body/div}"\mbox{}\newline 
\hspace*{6pt}{unit}="{book}"\hspace*{6pt}{use}="{@n}">}\mbox{}\newline 
\hspace*{6pt}{<\textbf{citeStructure}\hspace*{6pt}{delim}="{ }"\hspace*{6pt}{match}="{div}"\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{unit}="{chapter}"\hspace*{6pt}{use}="{position()}">}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{<\textbf{citeStructure}\hspace*{6pt}{delim}="{:}"\hspace*{6pt}{match}="{div}"\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}{unit}="{verse}"\hspace*{6pt}{use}="{position()}"/>}\mbox{}\newline 
\hspace*{6pt}{</\textbf{citeStructure}>}\mbox{}\newline 
{</\textbf{citeStructure}>}\end{shaded}\egroup 


