{<\textbf{funder}>}The Andrew W. Mellon Foundation{</\textbf{funder}>}\mbox{}\newline 
{<\textbf{funder}>}The Social Sciences and Humanities Research Council of Canada{</\textbf{funder}>}\end{shaded}\egroup 


