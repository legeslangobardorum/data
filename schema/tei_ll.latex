element person
{
   tei_att.global.attributes,
   tei_att.editLike.attributes,
   tei_att.sortable.attributes,
   attribute role { list { + } }?,
   attribute sex { list { + } }?,
   attribute gender { list { + } }?,
   attribute age { text }?,
   (
      tei_model.pLike+
    | ( tei_model.personPart | tei_model.global | tei_ptr )*
   )
}
\end{Verbatim}

