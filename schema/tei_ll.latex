    \item[{Member of}]
  \hyperref[TEI.model.standOffPart]{model.standOffPart}
    \item[{Contained by}]
  
    \item[linking: ]
   \hyperref[TEI.listAnnotation]{listAnnotation} \hyperref[TEI.standOff]{standOff}
    \item[{May contain}]
  
    \item[core: ]
   \hyperref[TEI.desc]{desc} \hyperref[TEI.head]{head} \hyperref[TEI.label]{label} \hyperref[TEI.note]{note}\par 
    \item[linking: ]
   \hyperref[TEI.annotation]{annotation} \hyperref[TEI.listAnnotation]{listAnnotation}
    \item[{Note}]
  \par
The enclosed annotations may use the general-purpose \hyperref[TEI.note]{<note>} element; or, for annotations pertaining to transcriptions of speech, the special-purpose \texttt{<annotationBlock>} element; or the \hyperref[TEI.annotation]{<annotation>} element, which is intended to map cleanly onto the Web Annotation Data Model.
    \item[{Example}]
  \leavevmode\bgroup\exampleFont \begin{shaded}\noindent\mbox{}{<\textbf{standOff}>}\mbox{}\newline 
\hspace*{6pt}{<\textbf{listAnnotation}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{<\textbf{note}\hspace*{6pt}{place}="{margin}"\hspace*{6pt}{resp}="{\#STC}"\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}{target}="{\#RotAM.4.15}"\hspace*{6pt}{type}="{gloss}">} The spell begins to\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}\hspace*{6pt} break {</\textbf{note}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{<\textbf{note}\hspace*{6pt}{place}="{bottom}"\hspace*{6pt}{resp}="{\#JLL}"\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}{target}="{\#RotAM.4.15}">} The turning point of the poem...\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{</\textbf{note}>}\mbox{}\newline 
\hspace*{6pt}{</\textbf{listAnnotation}>}\mbox{}\newline 
{</\textbf{standOff}>}\mbox{}\newline 
\textit{<!-- ... -->}\mbox{}\newline 
{<\textbf{lg}\hspace*{6pt}{rhyme}="{ABCB}"\hspace*{6pt}{xml:id}="{RotAM.4.15}">}\mbox{}\newline 
\hspace*{6pt}{<\textbf{l}>}The self-same moment I could pray;{</\textbf{l}>}\mbox{}\newline 
\hspace*{6pt}{<\textbf{l}>}And from my neck so free{</\textbf{l}>}\mbox{}\newline 
\hspace*{6pt}{<\textbf{l}>}The albatross fell off, and sank{</\textbf{l}>}\mbox{}\newline 
\hspace*{6pt}{<\textbf{l}>}Like lead into the sea.{</\textbf{l}>}\mbox{}\newline 
{</\textbf{lg}>}\end{shaded}\egroup 


    \item[{Example}]
  \leavevmode\bgroup\exampleFont \begin{shaded}\noindent\mbox{}{<\textbf{listAnnotation}>}\mbox{}\newline 
\hspace*{6pt}{<\textbf{annotationBlock}\hspace*{6pt}{corresp}="{\#u1}">}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{<\textbf{spanGrp}\hspace*{6pt}{type}="{pos}">}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}{<\textbf{span}\hspace*{6pt}{from}="{\#e14.w1}"\hspace*{6pt}{to}="{\#e14.w1}">}CONJ{</\textbf{span}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}{<\textbf{span}\hspace*{6pt}{from}="{\#e14.w2}"\hspace*{6pt}{to}="{\#e14.w2}">}RELPRO{</\textbf{span}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}{<\textbf{span}\hspace*{6pt}{from}="{\#e14.w3}"\hspace*{6pt}{to}="{\#e14.w3}">}V{</\textbf{span}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{</\textbf{spanGrp}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{<\textbf{spanGrp}\hspace*{6pt}{type}="{prosody}">}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}{<\textbf{span}\hspace*{6pt}{from}="{\#T0}"\hspace*{6pt}{to}="{\#T1}">}faster{</\textbf{span}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{</\textbf{spanGrp}>}\mbox{}\newline 
\hspace*{6pt}{</\textbf{annotationBlock}>}\mbox{}\newline 
\textit{<!-- ... annotationBlocks for \#u2 through \#u27 here -->}\mbox{}\newline 
{</\textbf{listAnnotation}>}\end{shaded}\egroup 


    \item[{Example}]
  \leavevmode\bgroup\exampleFont \begin{shaded}\noindent\mbox{}{<\textbf{listAnnotation}>}\mbox{}\newline 
\hspace*{6pt}{<\textbf{annotation}\hspace*{6pt}{motivation}="{commenting}"\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{target}="{\#match(bg-c1p1s1,'Gallia.*omnis')}"\hspace*{6pt}{xml:id}="{bgann1}">}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{<\textbf{respStmt}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}{<\textbf{resp}>}creator{</\textbf{resp}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}{<\textbf{persName}>}Francis Kelsey{</\textbf{persName}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{</\textbf{respStmt}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{<\textbf{note}>}‘Gaul as a whole,’ contrasted with Gaul in the narrower sense, or Celtic Gaul; Celtic Gaul also is often called Gallia.{</\textbf{note}>}\mbox{}\newline 
\hspace*{6pt}{</\textbf{annotation}>}\mbox{}\newline 
\hspace*{6pt}{<\textbf{annotation}\hspace*{6pt}{motivation}="{commenting}"\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{target}="{\#match(bg-c1p1s1,'Gallia.*divisa')}"\hspace*{6pt}{xml:id}="{bgann2}">}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{<\textbf{respStmt}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}{<\textbf{resp}>}creator{</\textbf{resp}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}{<\textbf{persName}>}Rice Holmes{</\textbf{persName}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{</\textbf{respStmt}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{<\textbf{note}>}Gallia...divisa: Notice the order of the words. ‘Gaul, taken as a whole, is divided’.{</\textbf{note}>}\mbox{}\newline 
\hspace*{6pt}{</\textbf{annotation}>}\mbox{}\newline 
\hspace*{6pt}{<\textbf{annotation}\hspace*{6pt}{motivation}="{commenting}"\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{target}="{\#match(bg-c1p1s1,'Belgae')}"\hspace*{6pt}{xml:id}="{bgann3}">}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{<\textbf{respStmt}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}{<\textbf{resp}>}creator{</\textbf{resp}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}{<\textbf{persName}>}Arthur Tappan Walker{</\textbf{persName}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{</\textbf{respStmt}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{<\textbf{note}>}Belgae -arum m., the Belgae or Belgians{</\textbf{note}>}\mbox{}\newline 
\hspace*{6pt}{</\textbf{annotation}>}\mbox{}\newline 
\hspace*{6pt}{<\textbf{annotation}\hspace*{6pt}{motivation}="{commenting}"\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{target}="{\#match(bg-c1p1s1,'Aquitani')}"\hspace*{6pt}{xml:id}="{bgann4}">}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{<\textbf{respStmt}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}{<\textbf{resp}>}creator{</\textbf{resp}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}{<\textbf{persName}>}Arthur Tappan Walker{</\textbf{persName}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{</\textbf{respStmt}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{<\textbf{note}>}Aquitani, -orum m.: the Aquitani, inhabiting southwestern Gaul{</\textbf{note}>}\mbox{}\newline 
\hspace*{6pt}{</\textbf{annotation}>}\mbox{}\newline 
\hspace*{6pt}{<\textbf{annotation}\hspace*{6pt}{motivation}="{commenting}"\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{target}="{\#match(bg-c1p1s1,'Celtae')}"\hspace*{6pt}{xml:id}="{bgann5}">}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{<\textbf{respStmt}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}{<\textbf{resp}>}creator{</\textbf{resp}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}{<\textbf{persName}>}Arthur Tappan Walker{</\textbf{persName}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{</\textbf{respStmt}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{<\textbf{note}>}Celtae, -arum m: the Celtae or Celts{</\textbf{note}>}\mbox{}\newline 
\hspace*{6pt}{</\textbf{annotation}>}\mbox{}\newline 
\hspace*{6pt}{<\textbf{annotation}\hspace*{6pt}{motivation}="{commenting}"\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{target}="{\#match(bg-c1p1s2,'Gallos(.|⃥n)*dividit')}"\hspace*{6pt}{xml:id}="{bgann6}">}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{<\textbf{respStmt}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}{<\textbf{resp}>}creator{</\textbf{resp}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}{<\textbf{persName}>}William Francis Allen{</\textbf{persName}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}{<\textbf{persName}>}Joseph Henry Allen{</\textbf{persName}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}{<\textbf{persName}>}Harry Pratt Judson{</\textbf{persName}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{</\textbf{respStmt}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{<\textbf{note}>}the verb is singular, because the two rivers make one boundary; as we should say,\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}\hspace*{6pt} ‘is divided by the line of the Seine and Marne.’{</\textbf{note}>}\mbox{}\newline 
\hspace*{6pt}{</\textbf{annotation}>}\mbox{}\newline 
{</\textbf{listAnnotation}>}\mbox{}\newline 
