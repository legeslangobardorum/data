\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}{</\textbf{person}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}{<\textbf{person}>}\mbox{}\newline 
