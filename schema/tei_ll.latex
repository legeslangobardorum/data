\begin{reflist}
\item[]\begin{specHead}{TEI.annotation}{<annotation> }represents an annotation following the Web Annotation Data Model. [\xref{https://www.tei-c.org/release/doc/tei-p5-doc/en/html/SA.html\#SASOstdf}{17.10. The standOff Container}]\end{specHead} 
    \item[{Module}]
  linking
    \item[{Attributes}]
  \begin{itemize}
\item \hyperref[TEI.att.global]{att.global}\begin{itemize}
\item \unusedattribute{xml:id}
\item @n
\item @xml:lang
\item @xml:base
\item @xml:space
\end{itemize} 
\item \hyperref[TEI.att.global.rendition]{att.global.rendition}\begin{itemize}
\item @rend
\item @style
\item @rendition
\end{itemize} 
\item \hyperref[TEI.att.global.linking]{att.global.linking}\begin{itemize}
\item @corresp
\item @synch
\item @sameAs
\item @copyOf
\item @next
\item @prev
\item @exclude
\item @select
\end{itemize} 
\item \hyperref[TEI.att.global.analytic]{att.global.analytic}\begin{itemize}
\item @ana
\end{itemize} 
\item \hyperref[TEI.att.global.facs]{att.global.facs}\begin{itemize}
\item @facs
\end{itemize} 
\item \hyperref[TEI.att.global.change]{att.global.change}\begin{itemize}
\item @change
\end{itemize} 
\item \hyperref[TEI.att.global.responsibility]{att.global.responsibility}\begin{itemize}
\item @cert
\item @resp
\end{itemize} 
\item \hyperref[TEI.att.global.source]{att.global.source}\begin{itemize}
\item @source
\end{itemize} 
\item \hyperref[TEI.att.pointing]{att.pointing}\begin{itemize}
\item \unusedattribute{target}
\item @targetLang
\item @evaluate
\end{itemize} 
\end{itemize} \hfil\\[-10pt]\begin{sansreflist}
    \item[@xml:id]
  (identifier) provides a unique identifier for the element bearing the attribute.
\begin{reflist}
    \item[{Derived from}]
  \hyperref[TEI.att.global]{att.global}
    \item[{Status}]
  Required
    \item[{Datatype}]
  \xref{https://www.w3.org/TR/xmlschema-2/\#ID}{ID}
\end{reflist}  
    \item[@target]
  specifies the destination of the reference by supplying one or more URI References
\begin{reflist}
    \item[{Derived from}]
  \hyperref[TEI.att.pointing]{att.pointing}
    \item[{Status}]
  Required
    \item[{Datatype}]
  1–∞ occurrences of \hyperref[TEI.teidata.pointer]{teidata.pointer} separated by whitespace
\end{reflist}  
    \item[@motivation]
  
\begin{reflist}
    \item[{Status}]
  Optional
    \item[{Datatype}]
  1–∞ occurrences of \hyperref[TEI.teidata.enumerated]{teidata.enumerated} separated by whitespace
    \item[{Legal values are:}]
  \begin{description}

\item[{assessing}]intent is to assess the target resource in some way, rather than simply make a comment about it
\item[{bookmarking}]intent is to create a bookmark to the target or part thereof
\item[{classifying}]intent is to classify the target in some way
\item[{commenting}]intent is to comment about the target
\item[{describing}]intent is to describe the target, rather than (for example) comment on it
\item[{editing}]intent is to request an edit or a change to the target resource
\item[{highlighting}]intent is to highlight the target resource or a segment thereof
\item[{identifying}]intent is to assign an identity to the target
\item[{linking}]intent is to link to a resource related to the target
\item[{moderating}]intent is to assign some value or quality to the target
\item[{questioning}]intent is to ask a question about the target
\item[{replying}]intent is to reply to a previous statement, either an annotation or another resource
\item[{tagging}]intent is to associate a tag with the target
\end{description} 
    \item[{Note}]
  \par
For further detailed explanation of the suggested values, see the Web Annotation Vocabulary (WAV). The motivations described here map to URIs defined by the WAV and when exported to RDF or JSON-LD must have the URI \texttt{http://www.w3.org/ns/oa\#} prepended.\par
As an RDF vocabulary, WADM permits the definition of new motivations (see Appendix C of the WAV). In TEI, new motivations may be defined in a custom ODD (see section 23.3.1.3). New motivations must also map to URIs defined by an RDF ontology extending the WAV.
\end{reflist}  
\end{sansreflist}  
    \item[{Member of}]
  \hyperref[TEI.model.annotationLike]{model.annotationLike}
    \item[{Contained by}]
  
    \item[linking: ]
   \hyperref[TEI.listAnnotation]{listAnnotation} \hyperref[TEI.standOff]{standOff}
    \item[{May contain}]
  
    \item[core: ]
   \hyperref[TEI.note]{note} \hyperref[TEI.ptr]{ptr} \hyperref[TEI.ref]{ref} \hyperref[TEI.respStmt]{respStmt}\par 
    \item[header: ]
   \hyperref[TEI.licence]{licence} \hyperref[TEI.revisionDesc]{revisionDesc}
    \item[{Example}]
  \leavevmode\bgroup\exampleFont \begin{shaded}\noindent\mbox{}{<\textbf{annotation}\hspace*{6pt}{motivation}="{linking}"\mbox{}\newline 
\hspace*{6pt}{target}="{\#Gallia}"\hspace*{6pt}{xml:id}="{ann1}">}\mbox{}\newline 
\textit{<!-- See https://www.w3.org/TR/annotation-model/\#lifecycle-information and \newline
             https://www.w3.org/TR/annotation-model/\#agents -->}\mbox{}\newline 
\hspace*{6pt}{<\textbf{respStmt}\hspace*{6pt}{xml:id}="{fred}">}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{<\textbf{resp}>}creator{</\textbf{resp}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{<\textbf{persName}>}Fred Editor{</\textbf{persName}>}\mbox{}\newline 
\hspace*{6pt}{</\textbf{respStmt}>}\mbox{}\newline 
\hspace*{6pt}{<\textbf{revisionDesc}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{<\textbf{change}\hspace*{6pt}{status}="{created}"\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}{when}="{2020-05-21T13:59:00Z}"\hspace*{6pt}{who}="{\#fred}"/>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{<\textbf{change}\hspace*{6pt}{status}="{modified}"\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}{when}="{2020-05-21T19:48:00Z}"\hspace*{6pt}{who}="{\#fred}"/>}\mbox{}\newline 
\hspace*{6pt}{</\textbf{revisionDesc}>}\mbox{}\newline 
\textit{<!-- See https://www.w3.org/TR/annotation-model/\#rights-information -->}\mbox{}\newline 
\hspace*{6pt}{<\textbf{licence}\hspace*{6pt}{target}="{http://creativecommons.org/licenses/by/3.0/}"/>}\mbox{}\newline 
\textit{<!-- Multiple bodies -->}\mbox{}\newline 
\textit{<!-- Pointers to sections of text in the same document -->}\mbox{}\newline 
\hspace*{6pt}{<\textbf{ptr}\hspace*{6pt}{target}="{\#string-range(c1p1s1,0,6)}"/>}\mbox{}\newline 
\hspace*{6pt}{<\textbf{ptr}\hspace*{6pt}{target}="{\#string-range(c1p1s6,19,7)}"/>}\mbox{}\newline 
{</\textbf{annotation}>}\end{shaded}\egroup 


    \item[{Example}]
  \leavevmode\bgroup\exampleFont \begin{shaded}\noindent\mbox{}{<\textbf{annotation}\hspace*{6pt}{motivation}="{commenting}"\mbox{}\newline 
\hspace*{6pt}{target}="{\#line1}"\hspace*{6pt}{xml:id}="{TheCorrectTitle}">}\mbox{}\newline 
\hspace*{6pt}{<\textbf{note}>}The correct title of this specification, and the correct full name of XML, is\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt} "Extensible Markup Language". "eXtensible Markup Language" is just a spelling error.\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt} However, the abbreviation "XML" is not only correct but, appearing as it does in the title\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt} of the specification, an official name of the Extensible Markup Language. {</\textbf{note}>}\mbox{}\newline 
{</\textbf{annotation}>}\end{shaded}\egroup 


    \item[{Content model}]
  \mbox{}\hfill\\[-10pt]\begin{Verbatim}[fontsize=\small]
<content>
 <sequence>
  <elementRef key="respStmt"
   maxOccurs="unbounded" minOccurs="0"/>
  <elementRef key="revisionDesc"
   maxOccurs="unbounded" minOccurs="0"/>
  <elementRef key="licence"
   maxOccurs="unbounded" minOccurs="0"/>
  <classRef key="model.annotationPart.body"
   maxOccurs="unbounded" minOccurs="0"/>
 </sequence>
</content>
    
\end{Verbatim}

    \item[{Schema Declaration}]
  \mbox{}\hfill\\[-10pt]\begin{Verbatim}[fontsize=\small]
element annotation
{
   tei_att.global.attribute.n,
   tei_att.global.attribute.xmllang,
   tei_att.global.attribute.xmlbase,
   tei_att.global.attribute.xmlspace,
   tei_att.global.rendition.attribute.rend,
   tei_att.global.rendition.attribute.style,
   tei_att.global.rendition.attribute.rendition,
   tei_att.global.linking.attribute.corresp,
   tei_att.global.linking.attribute.synch,
   tei_att.global.linking.attribute.sameAs,
   tei_att.global.linking.attribute.copyOf,
   tei_att.global.linking.attribute.next,
   tei_att.global.linking.attribute.prev,
   tei_att.global.linking.attribute.exclude,
   tei_att.global.linking.attribute.select,
   tei_att.global.analytic.attribute.ana,
   tei_att.global.facs.attribute.facs,
   tei_att.global.change.attribute.change,
   tei_att.global.responsibility.attribute.cert,
   tei_att.global.responsibility.attribute.resp,
   tei_att.global.source.attribute.source,
   tei_att.pointing.attribute.targetLang,
   tei_att.pointing.attribute.evaluate,
   attribute xml:id { text },
   attribute target { list { + } },
   attribute motivation
   {
      list
      {
         (
            "assessing"
          | "bookmarking"
          | "classifying"
          | "commenting"
          | "describing"
          | "editing"
          | "highlighting"
          | "identifying"
          | "linking"
          | "moderating"
          | "questioning"
          | "replying"
          | "tagging"
         )+
      }
   }?,
   (
      tei_respStmt*,
      tei_revisionDesc*,
      tei_licence*,
      tei_model.annotationPart.body*
   )
}
\end{Verbatim}

\end{reflist}  \index{app=<app>|oddindex}\index{type=@type!<app>|oddindex}\index{from=@from!<app>|oddindex}\index{to=@to!<app>|oddindex}\index{loc=@loc!<app>|oddindex}
