    \item[{Schema Declaration}]
  \mbox{}\hfill\\[-10pt]\begin{Verbatim}[fontsize=\small]
element re
{
   tei_att.global.attributes,
   tei_att.lexicographic.attributes,
   tei_att.typed.attributes,
   (
      text
    | tei_model.gLike    | tei_sense    | tei_model.entryPart.top    | tei_model.phrase    | tei_model.global   )*
}
\end{Verbatim}

