    \item[{Module}]
  tei
    \item[{Members}]
  \hyperref[TEI.c]{c} \hyperref[TEI.cl]{cl} \hyperref[TEI.m]{m} \hyperref[TEI.pc]{pc} \hyperref[TEI.phr]{phr} \hyperref[TEI.s]{s} \hyperref[TEI.seg]{seg} \hyperref[TEI.w]{w}
    \item[{Attributes}]
