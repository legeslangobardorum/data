    \item[{Contained by}]
  
    \item[header: ]
   \hyperref[TEI.teiHeader]{teiHeader}\par 
    \item[linking: ]
   \hyperref[TEI.annotation]{annotation}
    \item[{May contain}]
  
    \item[core: ]
   \hyperref[TEI.list]{list}\par 
    \item[header: ]
   \hyperref[TEI.change]{change} \hyperref[TEI.listChange]{listChange}
    \item[{Note}]
  \par
If present on this element, the {\itshape status} attribute should indicate the current status of the document. The same attribute may appear on any \hyperref[TEI.change]{<change>} to record the status at the time of that change. Conventionally \hyperref[TEI.change]{<change>} elements should be given in reverse date order, with the most recent change at the start of the list.
    \item[{Example}]
  \leavevmode\bgroup\exampleFont \begin{shaded}\noindent\mbox{}{<\textbf{revisionDesc}\hspace*{6pt}{status}="{embargoed}">}\mbox{}\newline 
\hspace*{6pt}{<\textbf{change}\hspace*{6pt}{when}="{1991-11-11}"\hspace*{6pt}{who}="{\#LB}">} deleted chapter 10 {</\textbf{change}>}\mbox{}\newline 
{</\textbf{revisionDesc}>}\end{shaded}\egroup 


    \item[{Content model}]
  \mbox{}\hfill\\[-10pt]\begin{Verbatim}[fontsize=\small]
<content>
 <alternate>
  <elementRef key="list"
   maxOccurs="unbounded" minOccurs="1"/>
  <elementRef key="listChange"
   maxOccurs="unbounded" minOccurs="1"/>
  <elementRef key="change"
   maxOccurs="unbounded" minOccurs="1"/>
 </alternate>
</content>
    
\end{Verbatim}

    \item[{Schema Declaration}]
  \mbox{}\hfill\\[-10pt]\begin{Verbatim}[fontsize=\small]
element revisionDesc
{
   tei_att.global.attributes,
   tei_att.docStatus.attributes,
   ( tei_list+ | tei_listChange+ | tei_change+ )
}
\end{Verbatim}

