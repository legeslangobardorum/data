\hspace*{6pt}{<\textbf{monogr}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{<\textbf{author}>}Blain, Virginia{</\textbf{author}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{<\textbf{author}>}Clements, Patricia{</\textbf{author}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{<\textbf{author}>}Grundy, Isobel{</\textbf{author}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{<\textbf{title}>}The Feminist Companion to Literature in English: women writers from the middle ages\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}\hspace*{6pt} to the present{</\textbf{title}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{<\textbf{edition}>}first edition{</\textbf{edition}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{<\textbf{imprint}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}{<\textbf{publisher}>}Yale University Press{</\textbf{publisher}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}{<\textbf{pubPlace}>}New Haven and London{</\textbf{pubPlace}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}{<\textbf{date}>}1990{</\textbf{date}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{</\textbf{imprint}>}\mbox{}\newline 
\hspace*{6pt}{</\textbf{monogr}>}\mbox{}\newline 
{</\textbf{biblStruct}>}\end{shaded}\egroup 


    \item[{Example}]
  \leavevmode\bgroup\exampleFont \begin{shaded}\noindent\mbox{}{<\textbf{biblStruct}\hspace*{6pt}{type}="{newspaper}">}\mbox{}\newline 
\hspace*{6pt}{<\textbf{analytic}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{<\textbf{author}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}{<\textbf{forename}>}David{</\textbf{forename}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}{<\textbf{surname}>}Barstow{</\textbf{surname}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{</\textbf{author}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{<\textbf{author}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}{<\textbf{forename}>}Susanne{</\textbf{forename}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}{<\textbf{surname}>}Craig{</\textbf{surname}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{</\textbf{author}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{<\textbf{author}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}{<\textbf{forename}>}Russ{</\textbf{forename}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}{<\textbf{surname}>}Buettner{</\textbf{surname}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{</\textbf{author}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{<\textbf{title}\hspace*{6pt}{type}="{main}">}Trump Took Part in Suspect Schemes to Evade Tax Bills{</\textbf{title}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{<\textbf{title}\hspace*{6pt}{type}="{sub}">}Behind the Myth of a Self-Made Billionaire, a Vast Inheritance From His Father{</\textbf{title}>}\mbox{}\newline 
\hspace*{6pt}{</\textbf{analytic}>}\mbox{}\newline 
\hspace*{6pt}{<\textbf{monogr}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{<\textbf{title}\hspace*{6pt}{level}="{j}">}The New York Times{</\textbf{title}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{<\textbf{imprint}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}{<\textbf{pubPlace}>}New York{</\textbf{pubPlace}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}{<\textbf{publisher}>}A. G. Sulzberger{</\textbf{publisher}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}\hspace*{6pt}{<\textbf{date}\hspace*{6pt}{when}="{2018-10-03}">}Wednesday, October 3, 2018{</\textbf{date}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{</\textbf{imprint}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{<\textbf{biblScope}\hspace*{6pt}{unit}="{volume}">}CLXVIII{</\textbf{biblScope}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{<\textbf{biblScope}\hspace*{6pt}{unit}="{issue}">}58,104{</\textbf{biblScope}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{<\textbf{biblScope}\hspace*{6pt}{unit}="{page}">}1{</\textbf{biblScope}>}\mbox{}\newline 
\hspace*{6pt}{</\textbf{monogr}>}\mbox{}\newline 
{</\textbf{biblStruct}>}\end{shaded}\egroup 


