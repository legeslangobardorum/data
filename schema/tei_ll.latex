\item \textit{@synch}
\item \textit{@sameAs}
\item \textit{@copyOf}
\item \textit{@next}
\item \textit{@prev}
\item \textit{@exclude}
\item \textit{@select}
\end{itemize} 
\item \hyperref[TEI.att.global.analytic]{att.global.analytic}\begin{itemize}
