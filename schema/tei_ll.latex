    \item[{May contain}]
  
    \item[core: ]
   \hyperref[TEI.bibl]{bibl} \hyperref[TEI.biblStruct]{biblStruct} \hyperref[TEI.head]{head} \hyperref[TEI.listBibl]{listBibl} \hyperref[TEI.note]{note} \hyperref[TEI.noteGrp]{noteGrp} \hyperref[TEI.p]{p}\par 
