    \item[{Schema Declaration}]
  \mbox{}\hfill\\[-10pt]\begin{Verbatim}[fontsize=\small]
element app
{
   tei_att.global.attributes,
   tei_att.typed.attribute.subtype,
   attribute type { text }?,
   attribute from { text }?,
   attribute to { text }?,
   attribute loc { list { + } }?,
   (
      tei_lem?,
      (
         tei_model.rdgLike       | tei_model.noteLike       | tei_witDetail       | tei_wit       | tei_rdgGrp      )*
   )
}
\end{Verbatim}

