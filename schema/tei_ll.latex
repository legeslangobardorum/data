{</\textbf{ruby}>}\mbox{}\newline 
{<\textbf{ruby}>}\mbox{}\newline 
\hspace*{6pt}{<\textbf{rb}>}I{</\textbf{rb}>}\mbox{}\newline 
\hspace*{6pt}{<\textbf{rt}>}aɪ{</\textbf{rt}>}\mbox{}\newline 
{</\textbf{ruby}>}\end{shaded}\egroup 


