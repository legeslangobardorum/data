    \item[{Note}]
  \par
A \hyperref[TEI.roleName]{<roleName>} may be distinguished from an \hyperref[TEI.addName]{<addName>} by virtue of the fact that, like a title, it typically exists independently of its holder.
    \item[{Example}]
  \leavevmode\bgroup\exampleFont \begin{shaded}\noindent\mbox{}{<\textbf{persName}>}\mbox{}\newline 
\hspace*{6pt}{<\textbf{forename}>}William{</\textbf{forename}>}\mbox{}\newline 
\hspace*{6pt}{<\textbf{surname}>}Poulteny{</\textbf{surname}>}\mbox{}\newline 
\hspace*{6pt}{<\textbf{roleName}>}Earl of Bath{</\textbf{roleName}>}\mbox{}\newline 
{</\textbf{persName}>}\end{shaded}\egroup 


    \item[{Example}]
  \leavevmode\bgroup\exampleFont \begin{shaded}\noindent\mbox{}{<\textbf{p}>}The {<\textbf{roleName}\hspace*{6pt}{role}="{solicitor\textunderscore general}">}S.G.{</\textbf{roleName}>} is the only national public official,\mbox{}\newline 
 including the Supreme Court justices, required by statute to be “learned in the law.”{</\textbf{p}>}\end{shaded}\egroup 


    \item[{Example}]
  \leavevmode\bgroup\exampleFont \begin{shaded}\noindent\mbox{}{<\textbf{p}>}\mbox{}\newline 
\hspace*{6pt}{<\textbf{persName}\hspace*{6pt}{ref}="{\#NJF}">}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{<\textbf{roleName}\hspace*{6pt}{role}="{solicitor\textunderscore general}">}Solicitor General{</\textbf{roleName}>} Noel J. Francisco{</\textbf{persName}>},\mbox{}\newline 
 representing the administration, asserted in rebuttal that there was nothing to disavow (...)\mbox{}\newline 
{<\textbf{persName}\hspace*{6pt}{ref}="{\#NJF}">}Francisco{</\textbf{persName}>} had violated the scrupulous standard of candor about the facts and\mbox{}\newline 
 the law that {<\textbf{roleName}\hspace*{6pt}{role}="{solicitor\textunderscore general}">}S.G.s{</\textbf{roleName}>}, in Republican and Democratic administrations\mbox{}\newline 
 alike, have repeatedly said they must honor.\mbox{}\newline 
{</\textbf{p}>}\end{shaded}\egroup 


