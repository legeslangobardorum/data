    \item[{Note}]
  \par
May contain any dictionary elements in any combination.\par
This element is used to mark part of a dictionary entry in which lower level dictionary elements appear, but which does not itself form an identifiable structural unit.
    \item[{Example}]
  \leavevmode\bgroup\exampleFont \begin{shaded}\noindent\mbox{}{<\textbf{entry}>}\mbox{}\newline 
\hspace*{6pt}{<\textbf{dictScrap}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{<\textbf{orth}>}biryani{</\textbf{orth}>} or {<\textbf{orth}>}biriani{</\textbf{orth}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{<\textbf{pron}>}(\%bIrI"A:nI){</\textbf{pron}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{<\textbf{def}>}any of a variety of Indian dishes ...{</\textbf{def}>}\mbox{}\newline 
\hspace*{6pt}\hspace*{6pt}{<\textbf{etym}>}[from {<\textbf{lang}>}Urdu{</\textbf{lang}>}]{</\textbf{etym}>}\mbox{}\newline 
\hspace*{6pt}{</\textbf{dictScrap}>}\mbox{}\newline 
{</\textbf{entry}>}\end{shaded}\egroup 


