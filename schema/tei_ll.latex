\hspace*{6pt}{<\textbf{persName}>}Ariel{</\textbf{persName}>}\mbox{}\newline 
\hspace*{6pt}{<\textbf{note}>}Character in {<\textbf{title}\hspace*{6pt}{level}="{m}">}The Tempest{</\textbf{title}>}.{</\textbf{note}>}\mbox{}\newline 
{</\textbf{person}>}\end{shaded}\egroup 


