 </alternate>
</content>
    
\end{Verbatim}

    \item[{Declaration}]
  \mbox{}\hfill\\[-10pt]\begin{Verbatim}[fontsize=\small]
tei_teidata.probCert = teidata.probability | teidata.certainty
\end{Verbatim}

\end{reflist}  
\begin{reflist}
