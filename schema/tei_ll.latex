    \item[{Schema Declaration}]
  \mbox{}\hfill\\[-10pt]\begin{Verbatim}[fontsize=\small]
element gramGrp
{
   tei_att.global.attributes,
   tei_att.lexicographic.attributes,
   tei_att.typed.attributes,
   (
      text
    | tei_model.gLike    | tei_model.phrase    | tei_model.inter    | tei_model.gramPart    | tei_model.global   )*
}
\end{Verbatim}

\end{reflist}  \index{graphic=<graphic>|oddindex}
\begin{reflist}
\item[]\begin{specHead}{TEI.graphic}{<graphic> }(graphic) indicates the location of a graphic or illustration, either forming part of a text, or providing an image of it. [\xref{https://www.tei-c.org/release/doc/tei-p5-doc/en/html/CO.html\#COGR}{3.10. Graphics and Other Non-textual Components} \xref{https://www.tei-c.org/release/doc/tei-p5-doc/en/html/PH.html\#PHFAX}{12.1. Digital Facsimiles}]\end{specHead} 
